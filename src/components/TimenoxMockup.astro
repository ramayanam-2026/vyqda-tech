---
// Pure HTML/CSS mockup of the Timenox attendance dashboard
// No images — every visual is CSS
---

<div class="tnx-shell" aria-hidden="true" role="img" aria-label="Timenox dashboard preview">
  <!-- Top bar -->
  <div class="tnx-topbar">
    <div class="tnx-topbar__left">
      <span class="tnx-badge">Timenox</span>
      <span class="tnx-topbar__title">Today's Attendance</span>
    </div>
    <span class="tnx-status-dot"></span>
  </div>

  <!-- Stat row -->
  <div class="tnx-stats">
    <div class="tnx-stat">
      <span class="tnx-stat__num">--</span>
      <span class="tnx-stat__label">Present</span>
    </div>
    <div class="tnx-stat">
      <span class="tnx-stat__num">--</span>
      <span class="tnx-stat__label">On Leave</span>
    </div>
    <div class="tnx-stat">
      <span class="tnx-stat__num">--</span>
      <span class="tnx-stat__label">Sites</span>
    </div>
  </div>

  <!-- Mini sparkline -->
  <div class="tnx-sparkline-wrap">
    <svg class="tnx-sparkline" viewBox="0 0 200 40" preserveAspectRatio="none">
      <defs>
        <linearGradient id="spark-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2BB8A0" stop-opacity="0.3"/>
          <stop offset="100%" stop-color="#2BB8A0" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <path d="M0 32 C20 28 35 10 55 12 S90 30 110 20 S150 8 170 14 S190 22 200 18 L200 40 L0 40 Z"
        fill="url(#spark-grad)"/>
      <path d="M0 32 C20 28 35 10 55 12 S90 30 110 20 S150 8 170 14 S190 22 200 18"
        fill="none" stroke="#2BB8A0" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <span class="tnx-sparkline-label">7-day attendance rate</span>
  </div>

  <!-- Attendance rows -->
  <div class="tnx-rows">
    {[
      { initials: 'AR', name: 'Employee A', role: 'Field — GPS', time: '08:52', status: 'present' },
      { initials: 'MS', name: 'Employee B', role: 'HQ — QR Scan', time: '09:04', status: 'present' },
      { initials: 'PK', name: 'Employee C', role: 'Remote', time: '--:--', status: 'leave' },
      { initials: 'JD', name: 'Employee D', role: 'HQ — QR Scan', time: '09:11', status: 'present' },
    ].map(row => (
      <div class="tnx-row">
        <div class={`tnx-avatar tnx-avatar--${row.status}`}>{row.initials}</div>
        <div class="tnx-row__info">
          <span class="tnx-row__name">{row.name}</span>
          <span class="tnx-row__role">{row.role}</span>
        </div>
        <div class="tnx-row__right">
          <span class="tnx-row__time">{row.time}</span>
          <span class={`tnx-pill tnx-pill--${row.status}`}>
            {row.status === 'present' ? 'Present' : 'Leave'}
          </span>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom action strip -->
  <div class="tnx-footer">
    <span class="tnx-qr-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="3" height="3"/>
      </svg>
      QR check-in active
    </span>
    <span class="tnx-gps-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="12" cy="10" r="3"/>
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
      </svg>
      GPS verified
    </span>
  </div>
</div>

<style>
.tnx-shell {
  background: var(--ink-900);
  border: 1px solid var(--line-dark);
  border-radius: var(--radius-lg);
  overflow: hidden;
  font-size: 12px;
}
.tnx-topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 14px;
  border-bottom: 1px solid var(--line-dark);
  background: var(--ink-800);
}
.tnx-topbar__left { display: flex; align-items: center; gap: 8px; }
.tnx-badge {
  font-family: var(--font-mono); font-size: 9px; font-weight: 600;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--teal-400); background: rgba(43,184,160,0.1);
  padding: 2px 6px; border-radius: 4px; border: 1px solid rgba(43,184,160,0.2);
}
.tnx-topbar__title { color: var(--text-on-dark); font-weight: 500; font-size: 11px; }
.tnx-status-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--teal-400);
  box-shadow: 0 0 6px rgba(43,184,160,0.6);
  animation: blink 2s ease-in-out infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }
@media (prefers-reduced-motion:reduce) { .tnx-status-dot{animation:none} }

.tnx-stats {
  display: flex; padding: 12px 14px; gap: 0;
  border-bottom: 1px solid var(--line-dark);
}
.tnx-stat {
  flex: 1; display: flex; flex-direction: column; gap: 2px;
  padding-right: 14px; border-right: 1px solid var(--line-dark);
}
.tnx-stat:last-child { border-right: none; padding-left: 14px; padding-right: 0; }
.tnx-stat:first-child { padding-left: 0; }
.tnx-stat__num {
  font-size: 18px; font-weight: 600; letter-spacing: -0.03em;
  color: var(--text-on-dark); line-height: 1;
  font-family: var(--font-mono);
}
.tnx-stat__label { font-size: 9px; color: var(--text-on-dark-muted); text-transform: uppercase; letter-spacing: 0.06em; }

.tnx-sparkline-wrap {
  padding: 8px 14px 4px;
  display: flex; flex-direction: column; gap: 3px;
}
.tnx-sparkline { width: 100%; height: 36px; display: block; }
.tnx-sparkline-label { font-size: 9px; color: var(--text-on-dark-muted); opacity: 0.7; }

.tnx-rows {
  display: flex; flex-direction: column;
  border-top: 1px solid var(--line-dark);
}
.tnx-row {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 14px;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  transition: background var(--duration-fast);
}
.tnx-row:last-child { border-bottom: none; }
.tnx-row:hover { background: rgba(255,255,255,0.03); }

.tnx-avatar {
  width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700; letter-spacing: 0.02em;
}
.tnx-avatar--present { background: rgba(43,184,160,0.15); color: var(--teal-400); border: 1px solid rgba(43,184,160,0.25); }
.tnx-avatar--leave { background: rgba(255,255,255,0.06); color: var(--text-on-dark-muted); border: 1px solid var(--line-dark); }

.tnx-row__info { flex: 1; display: flex; flex-direction: column; gap: 1px; overflow: hidden; }
.tnx-row__name { font-size: 11px; font-weight: 500; color: var(--text-on-dark); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tnx-row__role { font-size: 9px; color: var(--text-on-dark-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.tnx-row__right { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
.tnx-row__time { font-family: var(--font-mono); font-size: 10px; color: var(--text-on-dark-muted); }
.tnx-pill {
  padding: 1px 6px; border-radius: 100px; font-size: 8px; font-weight: 600;
  letter-spacing: 0.04em; text-transform: uppercase;
}
.tnx-pill--present { background: rgba(43,184,160,0.15); color: var(--teal-400); }
.tnx-pill--leave { background: rgba(255,255,255,0.06); color: var(--text-on-dark-muted); }

.tnx-footer {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 14px;
  background: rgba(255,255,255,0.02);
  border-top: 1px solid var(--line-dark);
}
.tnx-qr-hint, .tnx-gps-hint {
  display: flex; align-items: center; gap: 5px;
  font-size: 9px; color: var(--text-on-dark-muted); opacity: 0.7;
  font-family: var(--font-mono);
}
</style>
