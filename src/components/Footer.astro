---
import { COMPANY, PRODUCTS } from '../data/site';
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <!-- Top row -->
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="VYQDA Technologies">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="var(--teal-600)"/>
            <path d="M8 9l8 14 8-14" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M11 9h10" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <span>VYQDA</span>
        </a>
        <p class="footer-brand__desc">
          Enterprise SaaS for the modern workforce. Building products that scale with your organisation.
        </p>
        <div class="footer-social">
          <!-- TODO: Uncomment and link once social profiles are confirmed -->
          <!--
          <a href="TODO" aria-label="LinkedIn" rel="noopener noreferrer" target="_blank">
            <svg .../>
          </a>
          -->
          <span class="footer-social__placeholder">Social links — TODO</span>
        </div>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <p class="footer-col__heading">Products</p>
          <ul role="list">
            {PRODUCTS.map(p => (
              <li><a href={`/products/${p.slug}/`}>{p.name}</a></li>
            ))}
            <li><a href="/products/">All Products</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col__heading">Solutions</p>
          <ul role="list">
            <li><a href="/solutions/">Overview</a></li>
            <li><a href="/solutions/#enterprise">Enterprise</a></li>
            <li><a href="/solutions/#retail">Retail</a></li>
            <li><a href="/solutions/#field-ops">Field Operations</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col__heading">Resources</p>
          <ul role="list">
            <li><a href="/resources/">Resource Hub</a></li>
            <li><a href="/resources/#guides">Guides</a></li>
            <li><a href="/resources/#tools">Tools</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <p class="footer-col__heading">Company</p>
          <ul role="list">
            <li><a href="/company/">About</a></li>
            <li><a href="/security/">Security</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/contact/">Request a Demo</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-divider"></div>

    <!-- Bottom row -->
    <div class="footer-bottom">
      <p class="footer-legal">
        © {new Date().getFullYear()} {COMPANY.name}. All rights reserved.
      </p>
      <div class="footer-links">
        <a href="/privacy/">Privacy Policy</a>
        <a href="/terms/">Terms of Service</a>
        <a href="/security/">Security</a>
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer {
  background: var(--ink-950);
  color: var(--text-on-dark-muted);
  padding-top: clamp(3.5rem, 7vw, 7rem);
  padding-bottom: var(--space-8);
}

.footer-top {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: var(--space-16);
  align-items: start;
}

/* Brand column */
.footer-logo {
  display: flex; align-items: center; gap: var(--space-2);
  text-decoration: none; margin-bottom: var(--space-5);
}
.footer-logo span {
  font-size: 1.125rem; font-weight: 700;
  letter-spacing: -0.03em; color: var(--text-on-dark);
}
.footer-brand__desc {
  font-size: var(--text-sm); line-height: 1.65;
  color: var(--text-on-dark-muted); max-width: 280px;
  margin-bottom: var(--space-5);
}
.footer-social__placeholder {
  font-family: var(--font-mono);
  font-size: 11px; color: var(--text-on-dark-muted);
  opacity: 0.5;
}

/* Nav columns */
.footer-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
}
.footer-col__heading {
  font-family: var(--font-mono);
  font-size: var(--text-eyebrow);
  letter-spacing: var(--tracking-eyebrow);
  text-transform: uppercase;
  color: var(--text-on-dark);
  margin-bottom: var(--space-4);
}
.footer-col ul { display: flex; flex-direction: column; gap: var(--space-2); }
.footer-col a {
  font-size: var(--text-sm); color: var(--text-on-dark-muted);
  text-decoration: none; min-height: 28px; display: inline-block;
  transition: color var(--duration-fast);
}
.footer-col a:hover { color: var(--text-on-dark); }
.footer-col a:focus-visible { outline: 2px solid var(--teal-400); outline-offset: 2px; border-radius: 3px; }

.footer-divider {
  height: 1px; background: var(--line-dark);
  margin-block: var(--space-8);
}

.footer-bottom {
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: var(--space-4);
}
.footer-legal {
  font-size: var(--text-xs); color: var(--text-on-dark-muted);
}
.footer-links {
  display: flex; gap: var(--space-6); flex-wrap: wrap;
}
.footer-links a {
  font-size: var(--text-xs); color: var(--text-on-dark-muted);
  text-decoration: none; transition: color var(--duration-fast);
}
.footer-links a:hover { color: var(--text-on-dark); }
.footer-links a:focus-visible { outline: 2px solid var(--teal-400); outline-offset: 2px; border-radius: 3px; }

@media (max-width: 1024px) {
  .footer-top { grid-template-columns: 1fr; gap: var(--space-10); }
  .footer-nav { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .footer-nav { grid-template-columns: repeat(2, 1fr); gap: var(--space-8); }
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
</style>
