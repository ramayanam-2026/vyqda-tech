---
interface Props {
  heading?: string;
  subhead?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading = 'Ready to see VYQDA in action?',
  subhead = 'Schedule a personalised demo and see how the VYQDA platform can modernise your workforce operations.',
  primaryLabel = 'Request a Demo',
  primaryHref = '/contact/',
  secondaryLabel = 'Explore Products',
  secondaryHref = '/products/',
} = Astro.props;
---

<section class="cta-band section--dark" aria-labelledby="cta-heading">
  <div class="cta-band__aurora" aria-hidden="true"></div>
  <div class="container cta-band__inner">
    <div class="cta-band__content">
      <h2 id="cta-heading" class="heading-h2 text-on-dark reveal">{heading}</h2>
      <p class="body-lg text-on-dark-muted measure-sm reveal" data-delay="80">{subhead}</p>
    </div>
    <div class="btn-group reveal" data-delay="160">
      <a href={primaryHref} class="btn btn-primary btn-lg">{primaryLabel}</a>
      <a href={secondaryHref} class="btn btn-ghost btn-lg">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
.cta-band {
  position: relative;
  overflow: hidden;
  padding-block: clamp(5rem, 10vw, 10rem);
}
.cta-band__aurora {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 70% 60% at 15% 50%, rgba(15,127,110,0.18) 0%, transparent 70%),
    radial-gradient(ellipse 50% 70% at 85% 40%, rgba(59,111,224,0.10) 0%, transparent 70%);
}
.cta-band__inner {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--space-12);
  align-items: center;
}
.cta-band__content { display: flex; flex-direction: column; gap: var(--space-5); }

@media (max-width: 768px) {
  .cta-band__inner { grid-template-columns: 1fr; gap: var(--space-8); }
}
</style>
