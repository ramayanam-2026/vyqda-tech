---
// Platform constellation: VYQDA core + product nodes on orbital paths
// Pure SVG/CSS — no images, no JS animation libraries
---

<div class="constellation-wrap" aria-hidden="true">
  <svg
    class="constellation-svg"
    viewBox="0 0 560 480"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="VYQDA product ecosystem diagram"
  >
    <defs>
      <!-- Orbital ring gradient -->
      <linearGradient id="orb-ring" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2BB8A0" stop-opacity="0.15"/>
        <stop offset="100%" stop-color="#3B6FE0" stop-opacity="0.05"/>
      </linearGradient>

      <!-- Node glow filter -->
      <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"/>
        <feColorMatrix in="blur" type="matrix"
          values="0 0 0 0 0.17  0 0 0 0 0.72  0 0 0 0 0.63  0 0 0 0.6 0" result="glow"/>
        <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>

      <!-- Core glow -->
      <filter id="core-glow" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="10" result="blur"/>
        <feColorMatrix in="blur" type="matrix"
          values="0 0 0 0 0.06  0 0 0 0 0.50  0 0 0 0 0.43  0 0 0 0.5 0" result="glow"/>
        <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>

      <!-- Grid mask -->
      <pattern id="grid-pat" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
        <path d="M 28 0 L 0 0 0 28" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="0.5"/>
      </pattern>

      <!-- Dashed connection path animation -->
      <style>
        @media (prefers-reduced-motion: no-preference) {
          .conn-path { stroke-dasharray: 6 4; animation: dash-flow 3s linear infinite; }
          .conn-path-slow { stroke-dasharray: 6 4; animation: dash-flow 5s linear infinite; }
          .conn-path-rev { stroke-dasharray: 6 4; animation: dash-flow-rev 4s linear infinite; }
          @keyframes dash-flow { to { stroke-dashoffset: -40; } }
          @keyframes dash-flow-rev { to { stroke-dashoffset: 40; } }

          .node-pulse { animation: node-pulse 3s ease-in-out infinite; }
          .node-pulse-b { animation: node-pulse 3s ease-in-out infinite; animation-delay: -1s; }
          .node-pulse-c { animation: node-pulse 3s ease-in-out infinite; animation-delay: -2s; }
          .core-pulse { animation: core-pulse 4s ease-in-out infinite; }
          @keyframes node-pulse {
            0%, 100% { opacity: 0.6; r: 4; }
            50% { opacity: 1; r: 5.5; }
          }
          @keyframes core-pulse {
            0%, 100% { opacity: 0.9; }
            50% { opacity: 1; }
          }

          .ring-drift { animation: ring-drift 18s ease-in-out infinite alternate; }
          .ring-drift-b { animation: ring-drift 24s ease-in-out infinite alternate-reverse; }
          @keyframes ring-drift {
            from { transform: rotate(0deg); }
            to { transform: rotate(8deg); }
          }

          .orbit-dot-a { animation: orbit-a 14s linear infinite; }
          .orbit-dot-b { animation: orbit-b 20s linear infinite; }
          @keyframes orbit-a {
            from { transform: rotate(0deg) translateX(130px) rotate(0deg); }
            to { transform: rotate(360deg) translateX(130px) rotate(-360deg); }
          }
          @keyframes orbit-b {
            from { transform: rotate(180deg) translateX(190px) rotate(-180deg); }
            to { transform: rotate(540deg) translateX(190px) rotate(-540deg); }
          }
        }
      </style>
    </defs>

    <!-- Background grid -->
    <rect width="560" height="480" fill="url(#grid-pat)"/>

    <!-- Outer orbital ring -->
    <ellipse class="ring-drift-b" cx="280" cy="240" rx="195" ry="155"
      stroke="url(#orb-ring)" stroke-width="1" fill="none"
      transform-origin="280 240"/>

    <!-- Inner orbital ring -->
    <ellipse class="ring-drift" cx="280" cy="240" rx="130" ry="100"
      stroke="rgba(43,184,160,0.12)" stroke-width="1" fill="none"
      transform-origin="280 240"/>

    <!-- Connection lines: core → products -->
    <!-- Timenox top-right -->
    <line x1="280" y1="240" x2="400" y2="120"
      stroke="rgba(43,184,160,0.25)" stroke-width="1"/>
    <line class="conn-path" x1="280" y1="240" x2="400" y2="120"
      stroke="rgba(43,184,160,0.55)" stroke-width="1" stroke-dashoffset="0"/>

    <!-- Vyfoo right -->
    <line x1="280" y1="240" x2="470" y2="235"
      stroke="rgba(59,111,224,0.2)" stroke-width="1"/>
    <line class="conn-path-slow" x1="280" y1="240" x2="470" y2="235"
      stroke="rgba(59,111,224,0.5)" stroke-width="1"/>

    <!-- SHYFT bottom-right -->
    <line x1="280" y1="240" x2="390" y2="360"
      stroke="rgba(43,184,160,0.2)" stroke-width="1"/>
    <line class="conn-path-rev" x1="280" y1="240" x2="390" y2="360"
      stroke="rgba(43,184,160,0.45)" stroke-width="1"/>

    <!-- Retail bottom-left -->
    <line x1="280" y1="240" x2="155" y2="355"
      stroke="rgba(59,111,224,0.15)" stroke-width="1"/>
    <line class="conn-path" x1="280" y1="240" x2="155" y2="355"
      stroke="rgba(59,111,224,0.4)" stroke-width="1"/>

    <!-- Others top-left -->
    <line x1="280" y1="240" x2="140" y2="125"
      stroke="rgba(43,184,160,0.15)" stroke-width="1"/>
    <line class="conn-path-slow" x1="280" y1="240" x2="140" y2="125"
      stroke="rgba(43,184,160,0.4)" stroke-width="1"/>

    <!-- ── CORE NODE — VYQDA ── -->
    <g filter="url(#core-glow)" class="core-pulse" transform-origin="280 240">
      <circle cx="280" cy="240" r="38" fill="rgba(15,127,110,0.12)" stroke="rgba(43,184,160,0.3)" stroke-width="1.5"/>
      <circle cx="280" cy="240" r="26" fill="rgba(15,127,110,0.18)" stroke="rgba(43,184,160,0.5)" stroke-width="1"/>
      <!-- VYQDA logomark inside core -->
      <path d="M272 232l8 14 8-14" stroke="#2BB8A0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M269 232h14" stroke="#2BB8A0" stroke-width="2" stroke-linecap="round"/>
    </g>
    <text x="280" y="292" text-anchor="middle"
      font-family="'Geist Mono Variable', monospace" font-size="9" fill="rgba(43,184,160,0.7)"
      letter-spacing="0.12em" text-transform="uppercase">PLATFORM</text>

    <!-- ── PRODUCT NODES ── -->

    <!-- Timenox — top right -->
    <g filter="url(#node-glow)">
      <circle class="node-pulse" cx="400" cy="120" r="22" fill="rgba(6,11,22,0.7)"
        stroke="rgba(43,184,160,0.5)" stroke-width="1.5"/>
      <!-- QR icon hint -->
      <rect x="391" y="111" width="6" height="6" rx="1" fill="none" stroke="rgba(43,184,160,0.8)" stroke-width="1"/>
      <rect x="403" y="111" width="6" height="6" rx="1" fill="none" stroke="rgba(43,184,160,0.8)" stroke-width="1"/>
      <rect x="391" y="123" width="6" height="6" rx="1" fill="none" stroke="rgba(43,184,160,0.8)" stroke-width="1"/>
      <rect x="403" y="123" width="3" height="3" fill="rgba(43,184,160,0.8)"/>
    </g>
    <text x="400" y="155" text-anchor="middle"
      font-family="'Geist Mono Variable', monospace" font-size="9.5" fill="rgba(232,237,245,0.7)"
      letter-spacing="0.04em">Timenox</text>

    <!-- Vyfoo — right -->
    <g filter="url(#node-glow)">
      <circle class="node-pulse-b" cx="470" cy="235" r="19" fill="rgba(6,11,22,0.7)"
        stroke="rgba(59,111,224,0.5)" stroke-width="1.5"/>
      <path d="M462 231l8 8 8-8" stroke="rgba(91,143,249,0.8)" stroke-width="1.5" stroke-linecap="round" fill="none"/>
    </g>
    <text x="470" y="266" text-anchor="middle"
      font-family="'Geist Mono Variable', monospace" font-size="9.5" fill="rgba(232,237,245,0.7)"
      letter-spacing="0.04em">Vyfoo</text>

    <!-- SHYFT — bottom right -->
    <g filter="url(#node-glow)">
      <circle class="node-pulse-c" cx="390" cy="360" r="20" fill="rgba(6,11,22,0.7)"
        stroke="rgba(43,184,160,0.4)" stroke-width="1.5"/>
      <path d="M383 356h14M383 360h10M383 364h14" stroke="rgba(43,184,160,0.7)" stroke-width="1.5" stroke-linecap="round"/>
    </g>
    <text x="390" y="393" text-anchor="middle"
      font-family="'Geist Mono Variable', monospace" font-size="9.5" fill="rgba(232,237,245,0.7)"
      letter-spacing="0.04em">SHYFT</text>

    <!-- Vyqda Retail — bottom left -->
    <g filter="url(#node-glow)">
      <circle class="node-pulse" cx="155" cy="355" r="20" fill="rgba(6,11,22,0.7)"
        stroke="rgba(59,111,224,0.4)" stroke-width="1.5"/>
      <path d="M147 349h16l-2 12h-12z" stroke="rgba(91,143,249,0.7)" stroke-width="1.2" stroke-linecap="round" fill="none"/>
    </g>
    <text x="155" y="388" text-anchor="middle"
      font-family="'Geist Mono Variable', monospace" font-size="8.5" fill="rgba(232,237,245,0.7)"
      letter-spacing="0.04em">Vyqda Retail</text>

    <!-- Others — top left -->
    <g filter="url(#node-glow)">
      <circle class="node-pulse-b" cx="140" cy="125" r="17" fill="rgba(6,11,22,0.7)"
        stroke="rgba(43,184,160,0.3)" stroke-width="1"/>
      <circle cx="140" cy="125" r="4" fill="rgba(43,184,160,0.4)"/>
    </g>
    <text x="140" y="154" text-anchor="middle"
      font-family="'Geist Mono Variable', monospace" font-size="8.5" fill="rgba(154,168,191,0.6)"
      letter-spacing="0.04em">+ more</text>

    <!-- Floating orbit accent dots -->
    <g transform-origin="280 240">
      <circle class="orbit-dot-a" cx="280" cy="240" r="2.5" fill="rgba(43,184,160,0.5)"
        transform-origin="280 240"/>
    </g>
    <g transform-origin="280 240">
      <circle class="orbit-dot-b" cx="280" cy="240" r="2" fill="rgba(59,111,224,0.4)"
        transform-origin="280 240"/>
    </g>
  </svg>
</div>

<style>
.constellation-wrap {
  width: 100%; max-width: 560px;
  flex-shrink: 0;
}
.constellation-svg {
  width: 100%; height: auto;
  overflow: visible;
}
</style>
