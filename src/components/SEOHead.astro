---
import type { PageSEO } from '../data/seo';

interface Props {
  seo: PageSEO;
  jsonLd?: object[];
}

const { seo, jsonLd = [] } = Astro.props;
const ogTitle = seo.ogTitle ?? seo.title;
const ogDescription = seo.ogDescription ?? seo.description;

// Base Organization JSON-LD (on every page)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VYQDA Technologies Pvt. Ltd.',
  url: 'https://vyqda.com',
  logo: 'https://vyqda.com/og-logo.png', // TODO: create actual OG image
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@vyqda.com', // TODO: verify
    contactType: 'sales',
  },
  sameAs: [
    // TODO: add verified social profile URLs
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'VYQDA Technologies',
  url: 'https://vyqda.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://vyqda.com/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const allSchemas = [orgSchema, websiteSchema, ...jsonLd];
---

<!-- ── Primary meta ── -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
{seo.noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- ── Open Graph ── -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="VYQDA Technologies" />
<meta property="og:url" content={seo.canonical} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<!-- TODO: Add og:image once brand asset is available: 1200×630px SVG/PNG -->
<!-- <meta property="og:image" content="https://vyqda.com/og/default.png" /> -->

<!-- ── Twitter / X ── -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<!-- TODO: <meta name="twitter:site" content="@vyqdatech" /> -->

<!-- ── Fonts — preload critical variable font ── -->
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Self-hosted via @fontsource-variable — no external preconnect needed -->

<!-- ── JSON-LD ── -->
{allSchemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema, null, 0)} />
))}
