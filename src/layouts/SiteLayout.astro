---
import '../styles/reference-home.css';
import '../styles/site-pages.css';
const logo = 'https://zpsznnskr6ofckvj.public.blob.vercel-storage.com/vyqda-logo.png';
const { title = 'VYQDA Technologies | Software Products & Custom Development', description = 'Software products, custom software development and long-term technology solutions for businesses.', canonical = 'https://vyqda.com/', active = '' } = Astro.props;
const navItems = [{label:'Products',href:'/products/',key:'products'},{label:'Custom Development',href:'/services/',key:'services'},{label:'Platform Solutions',href:'/solutions/',key:'solutions'},{label:'Industries',href:'/industries/',key:'industries'},{label:'Company',href:'/about/',key:'about'},{label:'FAQs',href:'/faq/',key:'faq'},{label:'Free Tools',href:'/tools/',key:'tools'}];
const siteUrl = 'https://vyqda.com';
const pagePath = new URL(canonical).pathname;
const labels = {products:'Products',services:'Custom Development',solutions:'Platform Solutions',industries:'Industries',about:'About VYQDA',faq:'FAQs',tools:'Free Tools',contact:'Contact',timenox:'Timenox','timenox-360':'Timenox 360',vyfoo:'Vyfoo Restaurant POS',retail:'VYQDA Retail','shyft-box-finder':'SHYFT Box Finder'};
const pathParts = pagePath.split('/').filter(Boolean);
type BreadcrumbLabelKey = keyof typeof labels;
const getBreadcrumbLabel = (part: string): string => {
  if (Object.prototype.hasOwnProperty.call(labels, part)) return labels[part as BreadcrumbLabelKey];
  return part.replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
};
const breadcrumbs = [{ '@type':'ListItem', position:1, name:'Home', item:siteUrl + '/' }, ...pathParts.map((part,index)=>({ '@type':'ListItem', position:index+2, name:index===pathParts.length-1 ? title.replace(/ \\| VYQDA( Technologies)?$/,'') : getBreadcrumbLabel(part), item:siteUrl + '/' + pathParts.slice(0,index+1).join('/') + '/' }))];
const structuredData = { '@context':'https://schema.org', '@graph':[
  { '@type':'Organization', '@id':siteUrl+'/#organization', name:'VYQDA Technologies Pvt. Ltd.', url:siteUrl+'/', description:'Software products, custom software development and technology solutions for business operations.' },
  { '@type':'WebSite', '@id':siteUrl+'/#website', url:siteUrl+'/', name:'VYQDA Technologies', publisher:{'@id':siteUrl+'/#organization'}, inLanguage:'en' },
  { '@type':'WebPage', '@id':canonical+'#webpage', url:canonical, name:title, description, isPartOf:{'@id':siteUrl+'/#website'}, inLanguage:'en', breadcrumb:{'@id':canonical+'#breadcrumbs'} },
  { '@type':'BreadcrumbList', '@id':canonical+'#breadcrumbs', itemListElement:breadcrumbs }
]};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<script async src="https://www.googletagmanager.com/gtag/js?id=G-EX2ZX46SND"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-EX2ZX46SND');
</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#fffaf6" />
<meta property="og:locale" content="en_IN" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta property="og:site_name" content="VYQDA Technologies" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
</head>
<body id="top">
<header class="topbar">
<div class="topbar__inner wrap">
<a class="brand" href="/" aria-label="VYQDA Technologies home"><img class="brand__logo" src={logo} alt="VYQDA Technologies" /></a>
<nav class="nav" aria-label="Main navigation">{navItems.map(item => <a class:list={['nav__link', active === item.key && 'is-active']} href={item.href}>{item.label}</a>)}</nav>
<div class="topbar__actions"><a class="contact" href="/contact/">Contact Us <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h13M10 4l6 6-6 6"/></svg></a><button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open navigation menu"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button></div>
</div>
<nav class="mobile-nav wrap" id="mobile-nav" data-mobile-nav hidden aria-label="Mobile navigation">{navItems.map(item => <a href={item.href}>{item.label}</a>)}<a href="/contact/">Contact</a></nav>
</header>
