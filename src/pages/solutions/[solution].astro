---
import SiteLayout from '../../layouts/SiteLayout.astro';

import { solutions } from '../../data/solutions';


type SolutionSlug = keyof typeof solutions;

export function getStaticPaths() {
  return (Object.keys(solutions) as SolutionSlug[]).map((solution: SolutionSlug) => ({ params: { solution }, props: { data: solutions[solution] } }));
}

const { data } = Astro.props;
const canonical = 'https://vyqda.com/solutions/' + Astro.params.solution + '/';
---
<SiteLayout title={data.title} description={data.description} canonical={canonical} active="solutions">
  <section class="page-hero">
    <div class="wrap page-hero__inner">
      <p class="page-eyebrow">{data.eyebrow}</p>
      <h1>{data.intro}</h1>
      <p class="page-hero__lead">{data.lead}</p>
      <div class="page-hero__actions">
        <a class="button button--primary" href="/contact/#project-enquiry">Discuss Your Requirements <span aria-hidden="true">↗</span></a>
        <a class="button button--secondary" href={data.productUrl}>{data.productText}</a>
      </div>
    </div>
  </section>
  <section class="content-section">
    <div class="wrap page-split">
      <div class="section-heading-page">
        <p class="section-kicker">UNDERSTAND THE WORK</p>
        <h2>Start with the operating reality</h2>
        <p>{data.challenge}</p>
      </div>
      <div class="page-list">
        {data.needs.map((item: { title: string; body: string }, index: number) => <article class="page-list__item"><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}
      </div>
    </div>
  </section>
  <section class="content-section content-section--tint">
    <div class="wrap">
      <div class="section-heading-page">
        <p class="section-kicker">A PRACTICAL WAY FORWARD</p>
        <h2>Decide, validate, then roll out</h2>
        <p>A useful implementation plan makes assumptions visible and checks the important workflows before the system becomes part of daily operations.</p>
      </div>
      <ol class="page-list">
        {data.approach.map((step: string, index: number) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><p>{step}</p></div></li>)}
      </ol>
    </div>
  </section>
  <section class="content-section">
    <div class="wrap">
      <div class="page-cta">
        <div><p class="section-kicker">RELATED OPTION</p><h2>{data.product}</h2><p>{data.related}</p></div>
        <a class="button button--primary" href={data.relatedUrl}>Explore related approach <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
