---
import SiteLayout from '../../layouts/SiteLayout.astro';
const tools = [
{name:'Digital Card Builder',category:'Business & branding',icon:'▣',description:'Create a digital visiting card with contact details, a photo or logo, and social links.',features:['Profile and contact details','Photo and logo support','Social profile links'],href:'https://tools.vyqda.com/digital-card'},
{name:'File to PDF Converter',category:'Documents & PDF',icon:'PDF',description:'Convert supported images, text and documents into a shareable PDF without installing desktop software.',features:['Multiple supported formats','PDF export','Browser-based workflow'],href:'https://tools.vyqda.com/file-to-pdf'},
{name:'Invoice Generator',category:'Finance & billing',icon:'₹',description:'Prepare professional invoices with tax fields and export options for freelancers and small businesses.',features:['Invoice line items','Tax calculations','Professional output'],href:'https://tools.vyqda.com/invoice-generator'},
{name:'GST & Income Tax Calculator',category:'Finance & billing',icon:'%',description:'Explore GST, income tax, advance tax and TDS calculations for Indian tax scenarios. Verify important results against current official rules.',features:['GST calculations','Income-tax regime estimates','Advance tax and TDS'],href:'https://tools.vyqda.com/gst-and-income-tax-calculator/'},
{name:'Prompt Generator',category:'Writing & productivity',icon:'✳',description:'Structure clearer prompts for writing, coding, marketing and other AI-assisted tasks.',features:['Writing prompt ideas','Coding task structure','Marketing outlines'],href:'https://tools.vyqda.com/prompt-generator'},
{name:'QR Code Generator',category:'Business & branding',icon:'▦',description:'Create QR codes for websites, menus, contact details and other supported destinations.',features:['Website QR codes','WhatsApp destinations','Customisation options'],href:'https://tools.vyqda.com/qr-code-generator'},
{name:'Resume Formatter',category:'Careers & documents',icon:'CV',description:'Format resume content into a cleaner, easier-to-scan document for job applications.',features:['Readable resume structure','ATS-conscious formatting','PDF export options'],href:'https://tools.vyqda.com/resume-formatter'},
{name:'Smart Shift Planner',category:'Workforce & operations',icon:'▦',description:'Plan staff shifts using a visual schedule and identify potential overlaps or conflicts.',features:['Visual shift calendar','Drag-and-drop planning','Conflict checks'],href:'https://tools.vyqda.com/smart-shift-planner'},
{name:'Shoe Stock Analyzer',category:'Inventory & costing',icon:'↗',description:'Review footwear stock, estimate stock duration and examine costs, margins and inventory movement.',features:['Stock duration estimates','Cost and margin analysis','Turnover indicators'],href:'https://tools.vyqda.com/shoe-stock'},
{name:'Food Cost Analyzer',category:'Inventory & costing',icon:'∿',description:'Estimate recipe and ingredient costs and review stock duration and potential food waste.',features:['Recipe cost calculations','Stock duration estimates','Food waste analysis'],href:'https://tools.vyqda.com/food-cost'},
{name:'Construction Stock Analyzer',category:'Inventory & costing',icon:'⌂',description:'Organise construction material stock and estimate material costs and project-related consumption.',features:['Material stock tracking','Cost estimates','Project planning'],href:'https://tools.vyqda.com/construction'},
{name:'Furniture Cost Analyzer',category:'Inventory & costing',icon:'⌑',description:'Estimate furniture production costs and review wood inventory, stock duration and workshop profitability.',features:['Production cost estimates','Wood inventory review','Stock duration analysis'],href:'https://tools.vyqda.com/furniture-cost'},
{name:'WhatsApp Message Formatter',category:'Writing & productivity',icon:'“ ”',description:'Format message text with supported bold, italic, strikethrough and bullet styles before sharing.',features:['Bold and italic formatting','Bullet lists','Strikethrough text'],href:'https://tools.vyqda.com/whatsapp-message-formatter'}
];
const toolsStructuredData = { '@context':'https://schema.org', '@graph':[
  { '@type':'CollectionPage', '@id':'https://vyqda.com/tools/#webpage', name:'Free Online Business Tools | VYQDA', url:'https://vyqda.com/tools/', description:'Free online tools for document conversion, invoices, tax estimates, QR codes, resumes, workforce planning and stock analysis.', isPartOf:{'@id':'https://vyqda.com/#website'}, mainEntity:{ '@type':'ItemList', itemListElement:tools.map((tool,index)=>({ '@type':'ListItem', position:index+1, name:tool.name, url:tool.href })) } },
  { '@type':'FAQPage', '@id':'https://vyqda.com/tools/#faq', mainEntity:[
   { '@type':'Question', name:'Are these tools free to use?', acceptedAnswer:{'@type':'Answer',text:'The tools are presented as free utilities. Check each tool page for any updated terms or limitations.'}},
   { '@type':'Question', name:'Do I need to install software or create an account?', acceptedAnswer:{'@type':'Answer',text:'The tools page is designed for quick access without desktop installation. Tool-specific requirements will be shown on each tool page.'}},
   { '@type':'Question', name:'Can I rely on tax or cost calculator results for formal decisions?', acceptedAnswer:{'@type':'Answer',text:'Use calculator outputs as estimates and verify important results against current official guidance, source records or a qualified professional. Tax rules and assumptions can change.'}},
   { '@type':'Question', name:'Do these tools replace business software?', acceptedAnswer:{'@type':'Answer',text:'They help with specific tasks. For connected workflows in attendance, retail, restaurants or billing, explore VYQDA products or contact our team.'}}
  ]}
]};
---
<SiteLayout title="Free Online Tools for Business | PDF, Invoice & Tax | VYQDA" description="Use free online tools from VYQDA for PDF conversion, invoice creation, GST and income tax estimates, QR codes, shift planning, stock analysis, resumes and more." canonical="https://vyqda.com/tools/" active="tools">
<script type="application/ld+json">{JSON.stringify(toolsStructuredData)}</script>
<section class="page-hero tools-hero"><div class="wrap page-hero__inner"><p class="page-eyebrow">FREE ONLINE TOOLS · NO SIGN-UP REQUIRED</p><h1>Useful tools for <em>everyday work.</em></h1><p class="page-hero__lead">Convert documents, prepare invoices, estimate costs, format messages and organise business tasks with practical browser-based tools from VYQDA.</p><div class="page-hero__actions"><a class="button button--primary" href="#free-tools">Explore free tools ↓</a><a class="button button--secondary" href="/contact/">Talk to VYQDA</a></div><div class="tools-hero__signals"><span><b>01</b> Practical workflows</span><span><b>02</b> Mobile-friendly access</span><span><b>03</b> No installation required</span></div></div><div class="tools-hero__graphic" aria-hidden="true"><div class="tools-orbit tools-orbit--one"></div><div class="tools-orbit tools-orbit--two"></div><div class="tools-orbit tools-orbit--three"></div><div class="tools-hero__tile tools-hero__tile--a">PDF<span>↗</span></div><div class="tools-hero__tile tools-hero__tile--b">₹<span>GST</span></div><div class="tools-hero__tile tools-hero__tile--c">QR<span>▦</span></div><div class="tools-hero__tile tools-hero__tile--d">Aa<span>TXT</span></div></div></section>
<section class="content-section tools-intro"><div class="wrap tools-intro__grid"><div><p class="section-kicker">A SMALL TOOLKIT FOR BUSY TEAMS</p><h2>Get a task done, then get back to work.</h2></div><p>Choose a tool based on the job you need to complete. Supported formats, features and calculation assumptions can vary. Review inputs and outputs before relying on them for financial, tax or operational decisions.</p></div></section>
<section class="content-section content-section--tint" id="free-tools"><div class="wrap"><div class="section-heading-page"><p class="section-kicker">EXPLORE THE TOOLKIT</p><h2>Free online tools by category</h2><p>Choose a utility for document, business, workforce or inventory tasks. “Open tool” takes you to the relevant tool on tools.vyqda.com.</p></div><div class="tools-grid">{tools.map((tool,index)=><article class="tool-card"><div class="tool-card__top"><span class="tool-card__icon" aria-hidden="true">{tool.icon}</span><span class="tool-card__index">{String(index+1).padStart(2,'0')}</span></div><p class="tool-card__category">{tool.category}</p><h3>{tool.name}</h3><p class="tool-card__description">{tool.description}</p><ul>{tool.features.map(feature=><li>{feature}</li>)}</ul><a class="tool-card__link" href={tool.href} target="_blank" rel="noopener noreferrer">Open tool <span aria-hidden="true">↗</span></a></article>)}</div></div></section>
<section class="content-section"><div class="wrap tools-usecases"><div><p class="section-kicker">MADE FOR PRACTICAL TASKS</p><h2>Helpful for small businesses, teams and individuals.</h2><p>Use document tools for routine admin, calculators to explore estimates, and planning tools to organise common workflows. For important tax or financial decisions, validate calculations against current official guidance.</p><a class="page-text-link" href="/contact/">Need software tailored to your business? ↗</a></div><div class="tools-usecases__list"><article><span>01</span><div><h3>Small business owners</h3><p>Prepare invoices, review costs, create QR codes and organise everyday tasks.</p></div></article><article><span>02</span><div><h3>Freelancers and professionals</h3><p>Format resumes, documents and messages without installing additional software.</p></div></article><article><span>03</span><div><h3>Operations and workforce teams</h3><p>Explore shift planning and stock analysis utilities for practical planning.</p></div></article><article><span>04</span><div><h3>Food, footwear and construction businesses</h3><p>Use specialist cost and stock tools as a starting point for operational estimates.</p></div></article></div></div></section>
<section class="content-section content-section--tint"><div class="wrap"><div class="faq-page-list"><h2>Frequently asked questions about free online tools</h2><details><summary>Are these tools free to use?</summary><p>The tools are presented as free utilities. Check each tool page for any updated terms or limitations.</p></details><details><summary>Do I need to install software or create an account?</summary><p>The tools page is designed for quick access without desktop installation. Tool-specific requirements will be shown on each tool page.</p></details><details><summary>Can I rely on tax or cost calculator results for formal decisions?</summary><p>Use calculator outputs as estimates and verify important results against current official guidance, source records or a qualified professional. Tax rules and assumptions can change.</p></details><details><summary>Do these tools replace business software?</summary><p>They help with specific tasks. For connected workflows in attendance, retail, restaurants or billing, explore VYQDA products or contact our team.</p></details></div></div></section>
<section class="content-section"><div class="wrap"><div class="page-cta"><div><h2>Need more than a one-off tool?</h2><p>Explore VYQDA software products or discuss a workflow that needs a tailored solution.</p></div><div class="page-hero__actions"><a class="button button--primary" href="/products/">Explore Products ↗</a><a class="button button--secondary" href="/contact/">Contact VYQDA</a></div></div></div></section>
</SiteLayout>