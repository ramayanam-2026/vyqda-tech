---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import TimenoxMockup from '../../components/TimenoxMockup.astro';
import Icon from '../../components/Icon.astro';
import { SEO } from '../../data/seo';
import { PRODUCTS } from '../../data/site';

const product = PRODUCTS.find(p => p.id === 'timenox')!;
const seo = SEO.timenox;

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Timenox',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  description: seo.description,
  offers: { '@type': 'Offer', seller: { '@type': 'Organization', name: 'VYQDA Technologies Pvt. Ltd.' } },
  url: 'https://vyqda.com/products/timenox/',
};
---

<Base seo={seo} jsonLd={[softwareAppSchema]}>

  <!-- Hero -->
  <section class="product-hero section--dark">
    <div class="product-hero__aurora" aria-hidden="true"></div>
    <div class="container product-hero__inner">
      <div class="product-hero__copy">
        <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Products', href: '/products/' }, { label: 'Timenox' }]} />
        <div class="reveal">
          <span class="badge badge--dark mt-6" style="display:inline-flex">Employee Attendance Software</span>
          <h1 class="heading-h1 text-on-dark mt-5">{product.headline}</h1>
          <p class="body-lg text-on-dark-muted measure mt-6">{product.subhead}</p>
          <div class="btn-group mt-10">
            <a href="/contact/" class="btn btn-primary btn-lg">See Timenox in Action</a>
            <a href="/products/" class="btn btn-ghost btn-lg">All Products</a>
          </div>
        </div>
      </div>
      <div class="product-hero__visual reveal" data-delay="160">
        <TimenoxMockup />
      </div>
    </div>
  </section>

  <!-- Problem / solution narrative -->
  <section class="section" aria-labelledby="timenox-problem">
    <div class="container">
      <div class="narrative-grid">
        <div class="reveal">
          <span class="eyebrow">The Problem</span>
          <h2 id="timenox-problem" class="heading-h2 mt-3">
            Manual attendance fails at scale
          </h2>
          <p class="text-muted mt-5 measure" style="line-height:1.75">
            For organisations with dozens of locations and thousands of employees, paper registers and spreadsheet-based attendance are not just inefficient — they are inaccurate, easy to manipulate, and impossible to audit in real time. Buddy-punching, late data entry, and reconciliation errors all erode payroll accuracy and managerial confidence.
          </p>
          <p class="text-muted mt-4 measure" style="line-height:1.75">
            The problem compounds for hybrid and field teams. When some employees work from the office, others from home, and field staff across multiple sites, a single attendance system needs to handle all of it without creating friction for employees or extra work for HR.
          </p>
        </div>
        <div class="reveal" data-delay="100">
          <span class="eyebrow">The Timenox Approach</span>
          <h3 class="heading-h3 mt-3">Accurate, real-time, tamper-resistant</h3>
          <p class="text-muted mt-5 measure" style="line-height:1.75">
            Timenox replaces manual processes with a system designed around how modern workforces actually operate. QR check-ins take under five seconds. GPS verification confirms location at check-in without invasive continuous tracking. And a live dashboard gives managers immediate visibility — not end-of-day reports from the night before.
          </p>
          <p class="text-muted mt-4 measure" style="line-height:1.75">
            All attendance records are timestamped, geo-tagged where applicable, and stored in an immutable audit log. Payroll teams get accurate, reconciled data without manual correction cycles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature grid -->
  <section class="section section--alt" aria-labelledby="timenox-features">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Capabilities</span>
        <h2 id="timenox-features" class="heading-h2">Built for every work model</h2>
        <p class="body-lg text-muted measure mt-4">
          Timenox is designed for the full complexity of enterprise attendance — office-based, remote, hybrid, and field teams, managed from a single platform.
        </p>
      </div>
      <div class="grid-auto-3 mt-12">
        {product.features.map((f, i) => (
          <div class="feature-card card reveal" data-delay={i * 70}>
            <div class="feature-card__icon">
              <Icon name={f.icon} size={20} />
            </div>
            <h3 class="heading-h4 mt-5">{f.title}</h3>
            <p class="text-muted mt-3" style="font-size:var(--text-sm);line-height:1.65">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section" aria-labelledby="timenox-how">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">How It Works</span>
        <h2 id="timenox-how" class="heading-h2">From check-in to payroll in one system</h2>
      </div>
      <div class="steps mt-12">
        {[
          { n: '01', title: 'Generate shift QR codes', body: 'Administrators create unique, time-bound QR codes for each shift, site, or team. Codes expire automatically after the check-in window closes — preventing late or fraudulent scans.' },
          { n: '02', title: 'Employee scans to check in', body: 'Employees open the Timenox app and scan the shift QR code on arrival. The scan is timestamped instantly and the record appears in the manager dashboard within seconds.' },
          { n: '03', title: 'GPS confirms location', body: 'For sites where location verification is enabled, Timenox confirms the employee is within the defined geo-fence at check-in time. Field employees checking in from client sites can be verified against allowed locations.' },
          { n: '04', title: 'Managers see real-time data', body: 'The live dashboard shows who is present, who is on leave, coverage gaps, and any exceptions — in real time. No waiting for end-of-day roll-ups.' },
          { n: '05', title: 'Export to payroll', body: 'Accurate, reconciled attendance totals — including overtime flags, leave deductions, and shift variations — are available for export. TODO: confirm supported payroll and HRMS integrations.' },
        ].map((step, i) => (
          <div class="step reveal" data-delay={i * 60}>
            <div class="step__num">{step.n}</div>
            <div class="step__content">
              <h3 class="heading-h4">{step.title}</h3>
              <p class="text-muted mt-2" style="font-size:var(--text-sm);line-height:1.65">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section section--alt" aria-labelledby="timenox-usecases">
    <div class="container">
      <div class="two-up">
        <div class="reveal">
          <span class="eyebrow">Who It's For</span>
          <h2 id="timenox-usecases" class="heading-h2 mt-3">
            Designed for enterprise HR and operations teams
          </h2>
          <p class="text-muted mt-5 measure" style="line-height:1.75">
            Timenox is built for organisations that have outgrown spreadsheets and biometric terminals — where manual processes can't keep up with the scale and complexity of the workforce.
          </p>
          <p class="text-muted mt-4 measure" style="line-height:1.75">
            HR Directors gain accurate data for payroll and compliance. Operations Managers get real-time visibility into workforce presence. IT teams get a modern, API-first system that fits their existing stack. CFOs get reduced payroll leakage and a clear audit trail.
          </p>
        </div>
        <div class="usecase-list reveal" data-delay="100">
          <h3 class="heading-h4">Common use cases</h3>
          <ul class="usecase-items mt-6" role="list">
            {product.useCases.map(u => (
              <li class="usecase-item">
                <Icon name="check" size={14} class="feature-check" />
                <span>{u}</span>
              </li>
            ))}
          </ul>
          <div class="audience-tags mt-8">
            <p class="audience-tags__label">Stakeholders served</p>
            <div class="audience-tags__list">
              {product.audiences.map(a => <span class="badge badge--neutral">{a}</span>)}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical note -->
  <section class="section section--ink900" aria-labelledby="timenox-tech">
    <div class="container">
      <div class="tech-note reveal">
        <div class="tech-note__icon"><Icon name="shield" size={20} /></div>
        <div>
          <h2 id="timenox-tech" class="heading-h3 text-on-dark">Security and data integrity</h2>
          <p class="text-on-dark-muted mt-3 measure" style="line-height:1.75">
            Timenox is built on the VYQDA platform's enterprise security layer. All attendance records are stored with full audit trails, including scan timestamps, device identifiers, and location data where applicable. Role-based access ensures site managers see only their teams, while HR directors have organisation-wide visibility. Data residency and retention controls allow compliance with internal data governance policies.
          </p>
          <p class="text-on-dark-muted mt-3" style="font-family:var(--font-mono);font-size:var(--text-eyebrow);letter-spacing:var(--tracking-eyebrow);text-transform:uppercase;opacity:0.6">
            TODO: Add verified security certifications (ISO 27001, SOC 2 Type II, etc.) once confirmed.
          </p>
          <a href="/security/" class="btn btn-ghost mt-6" style="width:fit-content">
            View Security Overview <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    heading="See Timenox transform your attendance operations"
    subhead="Schedule a live demo and walk through the Timenox platform with a product specialist."
    primaryLabel="Request a Timenox Demo"
    secondaryLabel="View All Products"
    secondaryHref="/products/"
  />
</Base>

<style>
/* Hero */
.product-hero {
  position: relative; overflow: hidden;
  padding-block: clamp(4rem, 8vw, 8rem);
  padding-top: calc(var(--header-h) + clamp(3rem, 6vw, 6rem));
}
.product-hero__aurora {
  position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 60% 60% at 20% 50%, rgba(15,127,110,0.18) 0%, transparent 65%),
    radial-gradient(ellipse 40% 50% at 80% 40%, rgba(59,111,224,0.08) 0%, transparent 60%);
}
.product-hero__inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 480px; gap: var(--space-12); align-items: start; }
.product-hero__copy { display: flex; flex-direction: column; }
.product-hero__visual { padding-top: var(--space-4); }

/* Narrative */
.narrative-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start; }

/* Feature cards */
.feature-card { display: flex; flex-direction: column; }
.feature-card__icon { width: 44px; height: 44px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; background: var(--teal-100); color: var(--teal-600); }

/* Steps */
.steps { display: flex; flex-direction: column; gap: var(--space-1); }
.step { display: flex; gap: var(--space-6); align-items: flex-start; padding: var(--space-6); border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--canvas); transition: border-color var(--duration-base); }
.step:hover { border-color: rgba(15,127,110,0.25); }
.step__num { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 600; color: var(--teal-600); opacity: 0.4; flex-shrink: 0; min-width: 40px; line-height: 1.3; }
.step__content { display: flex; flex-direction: column; }

/* Use cases */
.two-up { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start; }
.usecase-items { display: flex; flex-direction: column; gap: var(--space-3); }
.usecase-item { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--text-sm); color: var(--text-muted); line-height: 1.5; }
.feature-check { color: var(--teal-600); flex-shrink: 0; margin-top: 2px; }
.audience-tags { display: flex; flex-direction: column; gap: var(--space-3); }
.audience-tags__label { font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--text-muted); }
.audience-tags__list { display: flex; flex-wrap: wrap; gap: var(--space-2); }

/* Tech note */
.tech-note { display: flex; gap: var(--space-6); align-items: flex-start; padding: var(--space-10); background: rgba(255,255,255,0.03); border: 1px solid var(--line-dark); border-radius: var(--radius-xl); }
.tech-note__icon { width: 48px; height: 48px; flex-shrink: 0; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; background: rgba(15,127,110,0.1); color: var(--teal-400); }

@media (max-width: 1024px) {
  .product-hero__inner { grid-template-columns: 1fr; }
  .narrative-grid { grid-template-columns: 1fr; gap: var(--space-10); }
  .two-up { grid-template-columns: 1fr; }
}
</style>
