---
import Base from '../../layouts/Base.astro';
import ProductPageStub from '../../components/ProductPageStub.astro';
import { SEO } from '../../data/seo';
import { PRODUCTS } from '../../data/site';

const slugMap: Record<string, string> = {
  'vyfoo': 'vyfoo',
  'vyqda-retail': 'vyqda-retail',
  'shyft': 'shyft',
};
const currentSlug = 'vyqda-retail';
const product = PRODUCTS.find(p => p.slug === currentSlug)!;
const seoKey = currentSlug.replace('-', '') as keyof typeof SEO;

// Build per-product schema
const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  description: product.subhead,
  offers: { '@type': 'Offer', seller: { '@type': 'Organization', name: 'VYQDA Technologies Pvt. Ltd.' } },
  url: 'https://vyqda.com/products/' + currentSlug + '/',
};

// Fall back to a generic SEO entry if key doesn't exist
import type { PageSEO } from '../../data/seo';
const seo: PageSEO = {
  title: product.name + ' — VYQDA Technologies',
  description: product.subhead + ' Part of the VYQDA enterprise SaaS ecosystem.',
  canonical: 'https://vyqda.com/products/' + currentSlug + '/',
  primaryKeyword: product.eyebrow !== 'TODO: Vyfoo product category' ? product.eyebrow : product.name,
  secondaryKeywords: ['VYQDA ' + product.name, product.name + ' software'],
};
---
<Base seo={seo} jsonLd={[softwareAppSchema]}>
  <ProductPageStub product={product} />
</Base>
