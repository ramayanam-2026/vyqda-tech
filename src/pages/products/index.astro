---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import TimenoxMockup from '../../components/TimenoxMockup.astro';
import { SEO } from '../../data/seo';
import { PRODUCTS } from '../../data/site';

const seo = SEO.products;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'VYQDA Product Ecosystem',
  url: 'https://vyqda.com/products/',
  description: seo.description,
};
---

<Base seo={seo} jsonLd={[jsonLd]}>
  <!-- Page header -->
  <section class="page-hero section--alt">
    <div class="container">
      <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Products' }]} />
      <div class="page-hero__inner">
        <div class="reveal">
          <span class="eyebrow">Product Ecosystem</span>
          <h1 class="heading-h1 mt-4">
            Every product your<br/>workforce operations need
          </h1>
          <p class="body-lg text-muted measure mt-6">
            The VYQDA suite is a set of purpose-built SaaS products, each solving a specific operational problem — and all sharing a unified enterprise platform for security, integration, and administration.
          </p>
        </div>
        <div class="page-hero__stats reveal" data-delay="120">
          {[
            { n: PRODUCTS.length.toString(), label: 'Products in the ecosystem' },
            { n: '1', label: 'Shared enterprise platform' },
            { n: 'TODO', label: 'Enterprises served' },
          ].map(s => (
            <div class="stat-block">
              <div class="stat-block__number">{s.n}</div>
              <div class="stat-block__label">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Platform intro -->
  <section class="section">
    <div class="container">
      <div class="platform-intro reveal">
        <div class="platform-intro__icon">
          <Icon name="layers" size={24} />
        </div>
        <div>
          <h2 class="heading-h3">One platform. Many products.</h2>
          <p class="text-muted mt-3 measure">
            Every VYQDA product is built on a shared infrastructure layer that handles identity and access management, data governance, REST APIs, multi-tenant administration, audit logging, and enterprise support. You get the depth of a specialist tool with the consistency of a platform.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Product cards -->
  <section class="section section--alt" aria-labelledby="all-products-heading">
    <div class="container">
      <h2 id="all-products-heading" class="sr-only">All Products</h2>

      <!-- Timenox — featured -->
      <article class="product-featured card reveal" aria-labelledby="prod-timenox">
        <div class="product-featured__content">
          <span class="eyebrow">Employee Attendance Software</span>
          <h2 id="prod-timenox" class="heading-h2 mt-3">Timenox</h2>
          <p class="body-lg text-muted mt-5 measure">
            Timenox is a complete employee attendance management platform built for modern work. QR check-ins that take seconds, GPS verification that prevents location fraud, and a real-time dashboard that gives managers the visibility they need — across office, remote, and field teams.
          </p>
          <ul class="product-featured__features mt-8" role="list">
            {[
              'QR-based check-in with time-bound codes',
              'GPS location verification at check-in',
              'Hybrid, remote, and field workforce support',
              'Real-time attendance dashboard',
              'Payroll-ready exports',
              'Multi-site administration',
            ].map(f => (
              <li class="product-featured__feature">
                <Icon name="check" size={14} class="feature-check" />
                {f}
              </li>
            ))}
          </ul>
          <div class="btn-group mt-10">
            <a href="/products/timenox/" class="btn btn-primary">Explore Timenox</a>
            <a href="/contact/" class="btn btn-secondary">Request a Demo</a>
          </div>
        </div>
        <div class="product-featured__visual">
          <TimenoxMockup />
        </div>
      </article>

      <!-- Other products grid -->
      <div class="products-grid mt-8">
        {PRODUCTS.filter(p => p.id !== 'timenox').map((product, i) => (
          <article class="product-card card reveal" data-delay={i * 80} aria-labelledby={`prod-${product.id}`}>
            <div class="product-card__header">
              <span class="eyebrow">{product.eyebrow}</span>
            </div>
            <h3 id={`prod-${product.id}`} class="heading-h3 mt-3">{product.name}</h3>
            <p class="text-muted mt-3" style="font-size:var(--text-sm);line-height:1.65">
              {product.subhead}
            </p>
            <ul class="product-card__features mt-6" role="list">
              {product.features.slice(0, 3).map(f => (
                <li>
                  <Icon name="check" size={12} class="feature-check" />
                  {f.title}
                </li>
              ))}
            </ul>
            <div class="btn-group mt-8">
              <a href={`/products/${product.slug}/`} class="btn btn-secondary btn-sm">
                Learn more <Icon name="arrow-right" size={13} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Shared platform detail -->
  <section class="section section--ink900" aria-labelledby="platform-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow eyebrow--dark">Shared Platform</span>
        <h2 id="platform-heading" class="heading-h2 text-on-dark">
          Enterprise-grade infrastructure, shared across every product
        </h2>
        <p class="body-lg text-on-dark-muted measure mt-4">
          All VYQDA products run on a common platform layer — so IT teams integrate once, security teams audit centrally, and administrators manage everything from a single console.
        </p>
      </div>
      <div class="grid-auto-3 mt-12">
        {[
          { icon: 'lock', title: 'Identity & Access', body: 'Role-based access control, SSO-ready, and fine-grained permissions across all products.' },
          { icon: 'globe', title: 'REST APIs & Webhooks', body: 'Documented APIs and event webhooks for integration with your HRMS, ERP, or data warehouse. TODO: confirm supported formats.' },
          { icon: 'shield', title: 'Data Governance', body: 'Audit logs, data residency controls, and retention policies. TODO: add verified compliance certifications.' },
          { icon: 'building', title: 'Multi-Tenant Admin', body: 'Manage multiple business units, subsidiaries, or sites from one administration console.' },
          { icon: 'chart', title: 'Reporting & Analytics', body: 'Cross-product reporting for HR, operations, and finance. TODO: confirm available report types.' },
          { icon: 'support', title: 'Enterprise Support', body: 'Dedicated onboarding, training, and named support contacts. TODO: confirm SLA tiers.' },
        ].map((f, i) => (
          <div class="platform-feature reveal" data-delay={i * 60}>
            <div class="platform-feature__icon">
              <Icon name={f.icon} size={18} />
            </div>
            <h3 class="heading-h4 mt-4">{f.title}</h3>
            <p class="text-on-dark-muted mt-2" style="font-size:var(--text-sm);line-height:1.6">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</Base>

<style>
.page-hero { padding-block: clamp(3.5rem, 7vw, 7rem); }
.page-hero__inner { display: grid; grid-template-columns: 1fr auto; gap: var(--space-12); align-items: start; margin-top: var(--space-8); }
.page-hero__stats { display: flex; flex-direction: column; gap: var(--space-8); padding: var(--space-8); background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-lg); min-width: 240px; }

.platform-intro {
  display: flex; gap: var(--space-6); align-items: flex-start;
  padding: var(--space-8); background: var(--canvas-alt); border: 1px solid var(--line); border-radius: var(--radius-xl);
}
.platform-intro__icon { width: 52px; height: 52px; flex-shrink: 0; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; background: var(--teal-100); color: var(--teal-600); }

.product-featured {
  display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: start;
  padding: var(--space-10);
}
.product-featured__content { display: flex; flex-direction: column; }
.product-featured__features { display: flex; flex-direction: column; gap: var(--space-3); }
.product-featured__feature { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--text-sm); color: var(--text-muted); }
.feature-check { color: var(--teal-600); flex-shrink: 0; margin-top: 2px; }

.products-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
.product-card { display: flex; flex-direction: column; }
.product-card__features { display: flex; flex-direction: column; gap: var(--space-2); margin-top: auto; }
.product-card__features li { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); color: var(--text-muted); }

.platform-feature { display: flex; flex-direction: column; }
.platform-feature__icon { width: 42px; height: 42px; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; background: rgba(43,184,160,0.1); color: var(--teal-400); border: 1px solid rgba(43,184,160,0.15); }

@media (max-width: 1024px) {
  .page-hero__inner { grid-template-columns: 1fr; }
  .page-hero__stats { flex-direction: row; min-width: unset; }
  .product-featured { grid-template-columns: 1fr; }
  .products-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 640px) {
  .products-grid { grid-template-columns: 1fr; }
}
</style>
