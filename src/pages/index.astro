---
import Base from '../layouts/Base.astro';
import HeroConstellation from '../components/HeroConstellation.astro';
import TimenoxMockup from '../components/TimenoxMockup.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { SEO } from '../data/seo';
import { PRODUCTS, PILLARS, SOLUTIONS, STATS, CREDIBILITY_LOGOS } from '../data/site';

const seo = SEO.home;

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VYQDA Technologies Pvt. Ltd.',
  url: 'https://vyqda.com',
  description: 'Enterprise SaaS company building workforce and operations management software.',
};
---

<Base seo={seo} jsonLd={[homeJsonLd]} heroTransparent={true}>

  <!-- ════════════════════════════════════════════
       §1  HERO
       ════════════════════════════════════════════ -->
  <section class="hero hero--reference" aria-labelledby="hero-heading">
    <div class="reference-orbit reference-orbit--outer" aria-hidden="true"></div>
    <div class="reference-orbit reference-orbit--inner" aria-hidden="true"></div>
    <div class="reference-orbit reference-orbit--core" aria-hidden="true"></div>
    <div class="reference-card reference-card--left reference-card--l1"><span class="reference-card__icon">&lt;/&gt;</span><span><strong>Custom<br/>Development</strong><small>Web, Mobile &amp; Cloud</small></span></div>
    <div class="reference-card reference-card--left reference-card--l2"><span class="reference-card__icon">▤</span><span><strong>Business<br/>Automation</strong><small>Streamline Operations</small></span></div>
    <div class="reference-card reference-card--left reference-card--l3"><span class="reference-card__icon">☁</span><span><strong>Scalable<br/>Solutions</strong><small>Built for Growth</small></span></div>
    <div class="reference-card reference-card--right reference-card--r1"><span class="reference-card__icon">▦</span><span><strong>Software<br/>Products</strong><small>Real Business Impact</small></span></div>
    <div class="reference-card reference-card--right reference-card--r2"><span class="reference-card__icon">♢</span><span><strong>Reliable<br/>Partnership</strong><small>Long-Term Support</small></span></div>
    <div class="reference-card reference-card--right reference-card--r3"><span class="reference-card__icon">↗</span><span><strong>Engineering<br/>Excellence</strong><small>Quality. Accountability.</small></span></div>
    <div class="hero__inner container">
      <p class="hero__eyebrow">SOFTWARE PRODUCTS <span>·</span> CUSTOM DEVELOPMENT <span>·</span> LONG-TERM PARTNERSHIP</p>
      <h1 id="hero-heading" class="hero__h1">Technology<br/>that helps businesses<br/><em>do more.</em></h1>
      <p class="hero__sub">VYQDA Technologies builds software products and delivers custom<br class="reference-desktop"/> technology solutions that help businesses operate efficiently,<br class="reference-desktop"/> solve real problems and grow with confidence.</p>
      <div class="hero__actions">
        <a href="/products/" class="hero__button hero__button--primary">Explore Our Products <span aria-hidden="true">→</span></a>
        <a href="/contact/" class="hero__button hero__button--secondary">Discuss Your Project</a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §2  CREDIBILITY STRIP
       ════════════════════════════════════════════ -->
  <section class="credibility section--sm" aria-label="Trusted by">
    <div class="container">
      <p class="credibility__label">
        <!-- TODO: Replace label once real customers can be named -->
        Trusted by enterprises across industries
      </p>
      <div class="credibility__logos" role="list">
        {CREDIBILITY_LOGOS.map(logo => (
          <div class="credibility__logo-slot" role="listitem" aria-label={logo.name}>
            <!-- TODO: Replace with real inline SVG logo once obtained with permission -->
            <span class="credibility__logo-placeholder">{logo.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §3  PRODUCT ECOSYSTEM BENTO GRID
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="products-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Product Ecosystem</span>
        <h2 id="products-heading" class="heading-h2">
          One platform.<br/>Multiple purpose-built products.
        </h2>
        <p class="body-lg text-muted measure mt-4">
          Each VYQDA product is built for a specific operational need — and all of them run on a shared enterprise-grade infrastructure for security, integration, and scale.
        </p>
      </div>

      <div class="bento-grid mt-12">
        <!-- Timenox — large featured card -->
        <article class="bento-card bento-card--featured card reveal" aria-labelledby="bento-timenox">
          <div class="bento-card__content">
            <span class="eyebrow">Employee Attendance Software</span>
            <h3 id="bento-timenox" class="heading-h3">Timenox</h3>
            <p class="text-muted mt-4">
              QR check-ins, GPS location verification, and real-time hybrid workforce visibility. Timenox replaces manual registers and spreadsheets with an attendance system that works for every work model.
            </p>
            <div class="bento-card__tags mt-6">
              <span class="badge">QR Check-In</span>
              <span class="badge">GPS Verify</span>
              <span class="badge">Hybrid Workforce</span>
            </div>
            <a href="/products/timenox/" class="btn btn-primary mt-8">
              Explore Timenox
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <div class="bento-card__visual">
            <TimenoxMockup />
          </div>
        </article>

        <!-- Vyfoo -->
        <article class="bento-card card card--product reveal" data-delay="60" aria-labelledby="bento-vyfoo">
          <div class="bento-card__icon">
            <Icon name="layers" size={22} />
          </div>
          <span class="eyebrow mt-4">TODO: Category</span>
          <h3 id="bento-vyfoo" class="heading-h3 mt-2">Vyfoo</h3>
          <p class="text-muted mt-3" style="font-size:var(--text-sm)">
            TODO: One-sentence value proposition for Vyfoo. Confirm capabilities before publishing.
          </p>
          <a href="/products/vyfoo/" class="bento-card__link mt-6">
            Learn more <Icon name="arrow-right" size={13} />
          </a>
        </article>

        <!-- Vyqda Retail -->
        <article class="bento-card card card--product reveal" data-delay="120" aria-labelledby="bento-retail">
          <div class="bento-card__icon bento-card__icon--blue">
            <Icon name="store" size={22} />
          </div>
          <span class="eyebrow eyebrow--blue mt-4">TODO: Category</span>
          <h3 id="bento-retail" class="heading-h3 mt-2">Vyqda Retail</h3>
          <p class="text-muted mt-3" style="font-size:var(--text-sm)">
            TODO: One-sentence value proposition for Vyqda Retail. Confirm capabilities before publishing.
          </p>
          <a href="/products/vyqda-retail/" class="bento-card__link mt-6">
            Learn more <Icon name="arrow-right" size={13} />
          </a>
        </article>

        <!-- SHYFT -->
        <article class="bento-card card card--product reveal" data-delay="180" aria-labelledby="bento-shyft">
          <div class="bento-card__icon">
            <Icon name="zap" size={22} />
          </div>
          <span class="eyebrow mt-4">TODO: Category</span>
          <h3 id="bento-shyft" class="heading-h3 mt-2">SHYFT</h3>
          <p class="text-muted mt-3" style="font-size:var(--text-sm)">
            TODO: One-sentence value proposition for SHYFT. Confirm capabilities before publishing.
          </p>
          <a href="/products/shyft/" class="bento-card__link mt-6">
            Learn more <Icon name="arrow-right" size={13} />
          </a>
        </article>

        <!-- Platform banner -->
        <div class="bento-platform reveal" data-delay="240">
          <Icon name="layers" size={16} class="bento-platform__icon" />
          <span>All products share a unified enterprise platform: shared identity, APIs, admin console, and support.</span>
          <a href="/products/" class="bento-platform__link">
            View all products →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §4  PLATFORM PILLARS
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="pillars-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Why VYQDA</span>
        <h2 id="pillars-heading" class="heading-h2">
          Enterprise-grade, by design
        </h2>
        <p class="body-lg text-muted measure mt-4">
          Every product in the VYQDA ecosystem is built on an infrastructure designed for the security, integration, and reliability demands of enterprise organisations.
        </p>
      </div>

      <div class="grid-auto-4 mt-12">
        {PILLARS.map((p, i) => (
          <div class="pillar-card card reveal" data-delay={i * 70}>
            <div class="pillar-card__icon">
              <Icon name={p.icon} size={20} />
            </div>
            <h3 class="heading-h4 mt-5">{p.title}</h3>
            <p class="text-muted mt-3" style="font-size:var(--text-sm);line-height:1.6">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §5  ARCHITECTURE DIAGRAM
       ════════════════════════════════════════════ -->
  <section class="section section--ink900" aria-labelledby="arch-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow eyebrow--dark">Platform Architecture</span>
        <h2 id="arch-heading" class="heading-h2 text-on-dark">
          Products. Platform. Customers.
        </h2>
        <p class="body-lg text-on-dark-muted measure mt-4">
          VYQDA products sit on a shared platform layer that handles identity, data governance, APIs, and integrations — so every product ships enterprise-ready from day one.
        </p>
      </div>

      <!-- SVG Architecture Diagram -->
      <div class="arch-diagram reveal mt-12" aria-label="Architecture: Products connect to VYQDA Platform which serves Enterprise Customers">
        <svg viewBox="0 0 800 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg" role="img">
          <defs>
            <marker id="arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
              <path d="M0,0 L0,6 L8,3 z" fill="rgba(43,184,160,0.5)"/>
            </marker>
            <style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');
.hero--reference{--orange:#f16d2b;--ink:#11182f;position:relative;isolation:isolate;overflow:hidden;min-height:490px;padding:44px 24px 30px;display:flex;align-items:center;justify-content:center;background:#fffaf6;color:var(--ink);font-family:'DM Sans',sans-serif}
.hero--reference:before{content:'';position:absolute;inset:0;z-index:-3;background:radial-gradient(ellipse at center,rgba(255,255,255,.9) 0%,rgba(255,250,246,.8) 42%,rgba(255,245,235,.65) 100%)}
.hero--reference:after{content:'';position:absolute;inset:auto 0 0;height:95px;z-index:-2;background:linear-gradient(160deg,transparent 0 30%,rgba(255,231,209,.34) 30.2% 100%);clip-path:polygon(0 42%,28% 100%,100% 100%,100% 0,78% 55%,50% 100%,20% 65%)}
.hero--reference .hero__inner{position:relative;z-index:3;width:min(100%,760px);padding:0;display:flex;flex-direction:column;align-items:center;text-align:center}
.hero--reference .hero__eyebrow{margin:0 0 22px;color:#bd5b2b;font-size:10px;line-height:1.4;letter-spacing:.2em;font-weight:700}
.hero--reference .hero__eyebrow span{padding:0 5px;color:var(--orange)}
.hero--reference .hero__h1{margin:0;color:var(--ink);font-family:'Playfair Display',Georgia,serif;font-size:clamp(43px,5.1vw,70px);font-weight:500;letter-spacing:-.045em;line-height:1.03}
.hero--reference .hero__h1 em{font-style:normal;color:var(--orange)}
.hero--reference .hero__sub{margin:18px 0 0;max-width:650px;color:#5e6069;font-size:16px;line-height:1.55;font-weight:400}
.hero--reference .hero__actions{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:24px}
.hero--reference .hero__button{height:50px;padding:0 26px;display:inline-flex;align-items:center;justify-content:center;gap:12px;border-radius:7px;font:600 13px 'DM Sans',sans-serif;text-decoration:none;transition:background .2s,transform .2s}
.hero--reference .hero__button:hover{transform:translateY(-2px)}
.hero--reference .hero__button--primary{background:var(--orange);color:white;border:1px solid var(--orange);box-shadow:0 5px 12px rgba(241,109,43,.16)}
.hero--reference .hero__button--secondary{background:rgba(255,255,255,.42);color:#242630;border:1px solid #efb18e}
.reference-orbit{position:absolute;z-index:-1;left:50%;top:48%;border:1px solid rgba(241,109,43,.24);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}
.reference-orbit--outer{width:min(920px,75vw);height:min(920px,75vw)}
.reference-orbit--inner{width:min(760px,62vw);height:min(760px,62vw);border-color:rgba(241,109,43,.12)}
.reference-orbit--core{width:min(600px,49vw);height:min(600px,49vw);border-color:rgba(241,109,43,.1)}
.reference-card{position:absolute;z-index:2;display:flex;align-items:center;gap:13px;width:200px;min-height:78px;padding:13px 15px;background:rgba(255,255,255,.78);border:1px solid rgba(235,218,205,.78);border-radius:13px;box-shadow:0 8px 25px rgba(67,45,28,.045);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);font-family:'DM Sans',sans-serif}
.reference-card:after{content:'';position:absolute;top:50%;width:40px;height:1px;background:rgba(241,109,43,.25)}
.reference-card--left:after{right:-40px}.reference-card--right:after{left:-40px}
.reference-card__icon{flex:0 0 34px;color:var(--orange);font-size:27px;font-weight:400;line-height:1;text-align:center}
.reference-card strong{display:block;font-size:12px;line-height:1.35;font-weight:700;color:#171a28}
.reference-card small{display:block;margin-top:4px;font-size:10px;line-height:1.35;color:#777780;white-space:nowrap}
.reference-card--left{left:clamp(22px,5.2vw,84px)}.reference-card--right{right:clamp(22px,5.2vw,84px)}
.reference-card--l1,.reference-card--r1{top:17%}.reference-card--l2,.reference-card--r2{top:43%}.reference-card--l3,.reference-card--r3{top:70%}
@media(min-width:1500px){.hero--reference{min-height:490px}.reference-card--left{left:8.3%}.reference-card--right{right:8.3%}}
@media(max-width:1050px){.reference-card{width:170px;padding:11px 10px;gap:8px}.reference-card--left{left:16px}.reference-card--right{right:16px}.reference-card:after{width:18px}.reference-card--left:after{right:-18px}.reference-card--right:after{left:-18px}.hero--reference .hero__inner{max-width:570px}.hero--reference .hero__h1{font-size:clamp(40px,5.3vw,58px)}.hero--reference .hero__sub{font-size:14px}}
@media(max-width:760px){.hero--reference{min-height:0;padding:74px 20px 52px}.hero--reference .hero__eyebrow{font-size:9px;letter-spacing:.13em;max-width:320px;line-height:1.8}.hero--reference .hero__h1{font-size:clamp(43px,10vw,60px)}.hero--reference .hero__sub{font-size:15px;max-width:490px}.reference-desktop{display:none}.reference-card{display:none}.reference-orbit--outer{width:115vw;height:115vw}.reference-orbit--inner{width:95vw;height:95vw}.reference-orbit--core{width:75vw;height:75vw}.hero--reference .hero__actions{width:100%;flex-direction:column;gap:10px}.hero--reference .hero__button{width:min(100%,330px)}}
@media(prefers-reduced-motion:reduce){.hero--reference .hero__button{transition:none}}
</style>