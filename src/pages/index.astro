---
import Base from '../layouts/Base.astro';
import HeroConstellation from '../components/HeroConstellation.astro';
import TimenoxMockup from '../components/TimenoxMockup.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import { SEO } from '../data/seo';
import { PRODUCTS, PILLARS, SOLUTIONS, STATS, CREDIBILITY_LOGOS } from '../data/site';

const seo = SEO.home;

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VYQDA Technologies Pvt. Ltd.',
  url: 'https://vyqda.com',
  description: 'Enterprise SaaS company building workforce and operations management software.',
};
---

<Base seo={seo} jsonLd={[homeJsonLd]} heroTransparent={true}>

  <!-- ════════════════════════════════════════════
       §1  HERO
       ════════════════════════════════════════════ -->
  <section class="hero hero--centered" aria-labelledby="hero-heading">
    <div class="hero__orbit hero__orbit--one" aria-hidden="true"></div>
    <div class="hero__orbit hero__orbit--two" aria-hidden="true"></div>
    <div class="hero__orbit hero__orbit--three" aria-hidden="true"></div>
    <div class="hero__inner container">
      <div class="hero__copy">
        <p class="hero__eyebrow"><span class="hero__eyebrow-dot"></span> SOFTWARE PRODUCTS & TECHNOLOGY SOLUTIONS</p>
        <h1 id="hero-heading" class="hero__h1">
          Technology that helps<br class="desktop-break" /> businesses <span class="hero__accent">do more.</span>
        </h1>
        <p class="hero__sub">
          VYQDA builds practical software products and custom technology solutions that help businesses manage work, streamline operations, and grow with confidence.
        </p>
        <div class="hero__actions">
          <a href="/products/" class="hero__button hero__button--primary">Explore our products <span aria-hidden="true">↗</span></a>
          <a href="/contact/" class="hero__button hero__button--secondary">Discuss your project <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero__capabilities" aria-label="Capabilities">
          <span>Custom software</span><i></i><span>SaaS products</span><i></i><span>Business automation</span><i></i><span>Ongoing support</span>
        </div>
      </div>
      <div class="hero__signature" aria-hidden="true">
        <span class="hero__signature-ring"></span>
        <span class="hero__signature-ring hero__signature-ring--inner"></span>
        <span class="hero__signature-core">V<span>.</span></span>
        <span class="hero__orbit-label hero__orbit-label--top">ENGINEERED FOR BUSINESS</span>
        <span class="hero__orbit-label hero__orbit-label--bottom">BUILT TO KEEP MOVING</span>
        <span class="hero__orbit-dot hero__orbit-dot--one"></span>
        <span class="hero__orbit-dot hero__orbit-dot--two"></span>
      </div>
    </div>
    <div class="hero__bottomline"><span>PRODUCT THINKING</span><span class="hero__bottomline-rule"></span><span>ENGINEERING DISCIPLINE</span><span class="hero__bottomline-rule"></span><span>LONG-TERM PARTNERSHIP</span></div>
  </section>

  <!-- ════════════════════════════════════════════
       §2  CREDIBILITY STRIP
       ════════════════════════════════════════════ -->
  <section class="credibility section--sm" aria-label="Trusted by">
    <div class="container">
      <p class="credibility__label">
        <!-- TODO: Replace label once real customers can be named -->
        Trusted by enterprises across industries
      </p>
      <div class="credibility__logos" role="list">
        {CREDIBILITY_LOGOS.map(logo => (
          <div class="credibility__logo-slot" role="listitem" aria-label={logo.name}>
            <!-- TODO: Replace with real inline SVG logo once obtained with permission -->
            <span class="credibility__logo-placeholder">{logo.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §3  PRODUCT ECOSYSTEM BENTO GRID
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="products-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Product Ecosystem</span>
        <h2 id="products-heading" class="heading-h2">
          One platform.<br/>Multiple purpose-built products.
        </h2>
        <p class="body-lg text-muted measure mt-4">
          Each VYQDA product is built for a specific operational need — and all of them run on a shared enterprise-grade infrastructure for security, integration, and scale.
        </p>
      </div>

      <div class="bento-grid mt-12">
        <!-- Timenox — large featured card -->
        <article class="bento-card bento-card--featured card reveal" aria-labelledby="bento-timenox">
          <div class="bento-card__content">
            <span class="eyebrow">Employee Attendance Software</span>
            <h3 id="bento-timenox" class="heading-h3">Timenox</h3>
            <p class="text-muted mt-4">
              QR check-ins, GPS location verification, and real-time hybrid workforce visibility. Timenox replaces manual registers and spreadsheets with an attendance system that works for every work model.
            </p>
            <div class="bento-card__tags mt-6">
              <span class="badge">QR Check-In</span>
              <span class="badge">GPS Verify</span>
              <span class="badge">Hybrid Workforce</span>
            </div>
            <a href="/products/timenox/" class="btn btn-primary mt-8">
              Explore Timenox
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <div class="bento-card__visual">
            <TimenoxMockup />
          </div>
        </article>

        <!-- Vyfoo -->
        <article class="bento-card card card--product reveal" data-delay="60" aria-labelledby="bento-vyfoo">
          <div class="bento-card__icon">
            <Icon name="layers" size={22} />
          </div>
          <span class="eyebrow mt-4">TODO: Category</span>
          <h3 id="bento-vyfoo" class="heading-h3 mt-2">Vyfoo</h3>
          <p class="text-muted mt-3" style="font-size:var(--text-sm)">
            TODO: One-sentence value proposition for Vyfoo. Confirm capabilities before publishing.
          </p>
          <a href="/products/vyfoo/" class="bento-card__link mt-6">
            Learn more <Icon name="arrow-right" size={13} />
          </a>
        </article>

        <!-- Vyqda Retail -->
        <article class="bento-card card card--product reveal" data-delay="120" aria-labelledby="bento-retail">
          <div class="bento-card__icon bento-card__icon--blue">
            <Icon name="store" size={22} />
          </div>
          <span class="eyebrow eyebrow--blue mt-4">TODO: Category</span>
          <h3 id="bento-retail" class="heading-h3 mt-2">Vyqda Retail</h3>
          <p class="text-muted mt-3" style="font-size:var(--text-sm)">
            TODO: One-sentence value proposition for Vyqda Retail. Confirm capabilities before publishing.
          </p>
          <a href="/products/vyqda-retail/" class="bento-card__link mt-6">
            Learn more <Icon name="arrow-right" size={13} />
          </a>
        </article>

        <!-- SHYFT -->
        <article class="bento-card card card--product reveal" data-delay="180" aria-labelledby="bento-shyft">
          <div class="bento-card__icon">
            <Icon name="zap" size={22} />
          </div>
          <span class="eyebrow mt-4">TODO: Category</span>
          <h3 id="bento-shyft" class="heading-h3 mt-2">SHYFT</h3>
          <p class="text-muted mt-3" style="font-size:var(--text-sm)">
            TODO: One-sentence value proposition for SHYFT. Confirm capabilities before publishing.
          </p>
          <a href="/products/shyft/" class="bento-card__link mt-6">
            Learn more <Icon name="arrow-right" size={13} />
          </a>
        </article>

        <!-- Platform banner -->
        <div class="bento-platform reveal" data-delay="240">
          <Icon name="layers" size={16} class="bento-platform__icon" />
          <span>All products share a unified enterprise platform: shared identity, APIs, admin console, and support.</span>
          <a href="/products/" class="bento-platform__link">
            View all products →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §4  PLATFORM PILLARS
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="pillars-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Why VYQDA</span>
        <h2 id="pillars-heading" class="heading-h2">
          Enterprise-grade, by design
        </h2>
        <p class="body-lg text-muted measure mt-4">
          Every product in the VYQDA ecosystem is built on an infrastructure designed for the security, integration, and reliability demands of enterprise organisations.
        </p>
      </div>

      <div class="grid-auto-4 mt-12">
        {PILLARS.map((p, i) => (
          <div class="pillar-card card reveal" data-delay={i * 70}>
            <div class="pillar-card__icon">
              <Icon name={p.icon} size={20} />
            </div>
            <h3 class="heading-h4 mt-5">{p.title}</h3>
            <p class="text-muted mt-3" style="font-size:var(--text-sm);line-height:1.6">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §5  ARCHITECTURE DIAGRAM
       ════════════════════════════════════════════ -->
  <section class="section section--ink900" aria-labelledby="arch-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow eyebrow--dark">Platform Architecture</span>
        <h2 id="arch-heading" class="heading-h2 text-on-dark">
          Products. Platform. Customers.
        </h2>
        <p class="body-lg text-on-dark-muted measure mt-4">
          VYQDA products sit on a shared platform layer that handles identity, data governance, APIs, and integrations — so every product ships enterprise-ready from day one.
        </p>
      </div>

      <!-- SVG Architecture Diagram -->
      <div class="arch-diagram reveal mt-12" aria-label="Architecture: Products connect to VYQDA Platform which serves Enterprise Customers">
        <svg viewBox="0 0 800 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg" role="img">
          <defs>
            <marker id="arr" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
              <path d="M0,0 L0,6 L8,3 z" fill="rgba(43,184,160,0.5)"/>
            </marker>
            <style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

/* Approved warm, centered corporate hero; abstract geometry is CSS-only. */
.hero--centered {
  --hero-ink: #22232b;
  --hero-muted: #696a70;
  --hero-orange: #ed762f;
  --hero-orange-dark: #d9601d;
  position: relative; isolation: isolate; overflow: hidden;
  min-height: min(850px, 100svh); display: flex; flex-direction: column;
  justify-content: center; padding: 138px 24px 78px;
  color: var(--hero-ink); background: #fffaf6;
  font-family: 'DM Sans', sans-serif;
}
.hero--centered::before {
  content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none;
  background: radial-gradient(ellipse at 50% 36%, rgba(247,174,126,.16), transparent 48%),
              linear-gradient(90deg, rgba(237,118,47,.035) 1px, transparent 1px),
              linear-gradient(rgba(237,118,47,.035) 1px, transparent 1px);
  background-size: auto, 58px 58px, 58px 58px;
  mask-image: linear-gradient(to bottom, black, transparent 92%);
}
.hero--centered .hero__inner {
  width: min(100%, 1120px); margin-inline: auto; position: relative; z-index: 2;
  display: flex; flex-direction: column; align-items: center; text-align: center;
  gap: 0; padding: 0;
}
.hero--centered .hero__copy { max-width: 900px; align-items: center; gap: 0; }
.hero--centered .hero__eyebrow {
  display: inline-flex; align-items: center; gap: 10px; margin: 0 0 27px;
  color: #a85425; font-size: 11px; font-weight: 700; letter-spacing: .16em;
}
.hero__eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--hero-orange); box-shadow: 0 0 0 4px rgba(237,118,47,.12); }
.hero--centered .hero__h1 {
  margin: 0; color: var(--hero-ink); font-family: 'Playfair Display', Georgia, serif;
  font-weight: 500; font-size: clamp(46px, 6.5vw, 82px); letter-spacing: -.045em;
  line-height: 1.075; max-width: 920px;
}
.hero--centered .hero__accent { color: var(--hero-orange); background: none; -webkit-text-fill-color: currentColor; }
.hero--centered .hero__sub {
  margin: 26px auto 0; max-width: 650px; color: var(--hero-muted);
  font-size: clamp(16px, 1.55vw, 19px); line-height: 1.8; font-weight: 400;
}
.hero__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 13px; margin-top: 32px; }
.hero__button {
  min-height: 52px; padding: 0 23px; display: inline-flex; align-items: center; justify-content: center; gap: 14px;
  border-radius: 6px; text-decoration: none; font: 600 14px 'DM Sans', sans-serif;
  transition: transform .2s ease, background .2s ease, border-color .2s ease;
}
.hero__button:hover { transform: translateY(-2px); }
.hero__button--primary { color: #fff; background: var(--hero-orange); border: 1px solid var(--hero-orange); box-shadow: 0 8px 22px rgba(217,96,29,.16); }
.hero__button--primary:hover { background: var(--hero-orange-dark); border-color: var(--hero-orange-dark); }
.hero__button--secondary { color: var(--hero-ink); background: rgba(255,255,255,.55); border: 1px solid #e7d9cf; }
.hero__button--secondary:hover { border-color: #d9a17e; background: #fff; }
.hero__capabilities { margin-top: 27px; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; color: #77736f; font-size: 12px; }
.hero__capabilities i { display: block; width: 3px; height: 3px; border-radius: 50%; background: #e4a17a; }
.hero__signature { position: relative; width: 150px; height: 150px; margin-top: 54px; display: grid; place-items: center; }
.hero__signature-ring { position: absolute; width: 142px; height: 142px; border: 1px solid rgba(237,118,47,.23); border-radius: 50%; }
.hero__signature-ring::before, .hero__signature-ring::after { content: ''; position: absolute; inset: 12px -1px; border: 1px solid rgba(237,118,47,.13); border-radius: 50%; transform: rotate(55deg); }
.hero__signature-ring::after { transform: rotate(-55deg); }
.hero__signature-ring--inner { width: 92px; height: 92px; border-color: rgba(237,118,47,.3); }
.hero__signature-core { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: #fff; border: 1px solid #f1d7c6; box-shadow: 0 8px 28px rgba(118,70,42,.08); color: #292932; font: 600 30px 'Playfair Display', Georgia, serif; }
.hero__signature-core span { color: var(--hero-orange); }
.hero__orbit-label { position: absolute; font-size: 8px; letter-spacing: .14em; font-weight: 700; color: #b07a5b; white-space: nowrap; }
.hero__orbit-label--top { top: 0; }
.hero__orbit-label--bottom { bottom: 0; }
.hero__orbit-dot { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: var(--hero-orange); box-shadow: 0 0 0 5px rgba(237,118,47,.12); }
.hero__orbit-dot--one { top: 29px; right: 13px; }
.hero__orbit-dot--two { bottom: 29px; left: 13px; width: 5px; height: 5px; background: #d9a17e; }
.hero__orbit { position: absolute; z-index: -1; border: 1px solid rgba(237,118,47,.11); border-radius: 50%; pointer-events: none; }
.hero__orbit--one { width: 430px; height: 430px; top: 12%; left: -310px; }
.hero__orbit--two { width: 560px; height: 560px; top: 5%; right: -420px; }
.hero__orbit--three { width: 260px; height: 260px; bottom: -210px; left: 46%; }
.hero__bottomline { position: absolute; bottom: 26px; left: 24px; right: 24px; display: flex; align-items: center; justify-content: center; gap: 17px; color: #aaa09a; font-size: 9px; font-weight: 700; letter-spacing: .14em; }
.hero__bottomline-rule { width: 32px; height: 1px; background: #e9d9ce; }
@media (max-width: 640px) {
  .hero--centered { min-height: auto; padding: 122px 20px 82px; }
  .hero--centered .hero__eyebrow { font-size: 9px; letter-spacing: .12em; margin-bottom: 22px; }
  .hero--centered .hero__h1 { font-size: clamp(42px, 11vw, 60px); line-height: 1.1; letter-spacing: -.04em; }
  .desktop-break { display: none; }
  .hero--centered .hero__sub { font-size: 16px; line-height: 1.7; margin-top: 21px; }
  .hero__actions { width: 100%; margin-top: 26px; flex-direction: column; align-items: stretch; }
  .hero__button { width: 100%; }
  .hero__capabilities { gap: 8px; font-size: 11px; max-width: 330px; line-height: 1.7; }
  .hero__signature { margin-top: 38px; transform: scale(.86); }
  .hero__bottomline { bottom: 20px; gap: 8px; font-size: 7px; letter-spacing: .08em; }
  .hero__bottomline-rule { width: 12px; }
}
@media (prefers-reduced-motion: reduce) { .hero__button { transition: none; } }

/* ── Existing homepage sections ── */

              @media (prefers-reduced-motion: no-preference) {
                .arch-conn { stroke-dasharray: 5 3; animation: arch-dash 4s linear infinite; }
                .arch-conn-r { stroke-dasharray: 5 3; animation: arch-dash 4s linear infinite reverse; }
                @keyframes arch-dash { to { stroke-dashoffset: -40; } }
              }
            </style>
          </defs>

          <!-- Products layer -->
          <g>
            <rect x="10" y="90" width="140" height="120" rx="10" fill="rgba(255,255,255,0.04)" stroke="rgba(43,184,160,0.2)" stroke-width="1"/>
            <text x="80" y="76" text-anchor="middle" font-family="'Geist Mono Variable',monospace" font-size="9" fill="rgba(154,168,191,0.6)" letter-spacing="0.1em">PRODUCTS</text>
            {['Timenox','Vyfoo','SHYFT','Vyqda Retail'].map((name, i) => (
              <>
                <rect x="20" y={100 + i*24} width="120" height="18" rx="4" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <text x="80" y={113 + i*24} text-anchor="middle" font-family="'Geist Mono Variable',monospace" font-size="9" fill="rgba(232,237,245,0.65)">{name}</text>
              </>
            ))}
          </g>

          <!-- Arrow: Products → Platform -->
          <line class="arch-conn" x1="152" y1="150" x2="228" y2="150" stroke="rgba(43,184,160,0.4)" stroke-width="1" marker-end="url(#arr)"/>

          <!-- Platform layer (center, taller) -->
          <g>
            <rect x="230" y="40" width="340" height="220" rx="12" fill="rgba(15,127,110,0.08)" stroke="rgba(43,184,160,0.3)" stroke-width="1"/>
            <text x="400" y="28" text-anchor="middle" font-family="'Geist Mono Variable',monospace" font-size="9" fill="rgba(43,184,160,0.7)" letter-spacing="0.1em">VYQDA PLATFORM</text>

            {[
              ['Identity & Access', 'Role-based access, SSO'],
              ['REST APIs & Webhooks', 'Integration-ready'],
              ['Data Governance', 'Residency controls'],
              ['Admin Console', 'Multi-tenant, multi-site'],
              ['Audit & Logging', 'Full event trail'],
              ['Support & SLA', 'TODO: tiers'],
            ].map(([title, sub], i) => {
              const col = i % 2;
              const row = Math.floor(i / 2);
              return (
                <g>
                  <rect x={248 + col*162} y={60 + row*64} width={148} height={52} rx="6"
                    fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                  <text x={248 + col*162 + 74} y={84 + row*64} text-anchor="middle"
                    font-family="'Geist Mono Variable',monospace" font-size="9" font-weight="600"
                    fill="rgba(232,237,245,0.8)">{title}</text>
                  <text x={248 + col*162 + 74} y={99 + row*64} text-anchor="middle"
                    font-family="'Geist Mono Variable',monospace" font-size="8"
                    fill="rgba(154,168,191,0.6)">{sub}</text>
                </g>
              );
            })}
          </g>

          <!-- Arrow: Platform → Customers -->
          <line class="arch-conn-r" x1="572" y1="150" x2="648" y2="150" stroke="rgba(59,111,224,0.4)" stroke-width="1" marker-end="url(#arr)"/>

          <!-- Customers layer -->
          <g>
            <rect x="650" y="90" width="140" height="120" rx="10" fill="rgba(255,255,255,0.04)" stroke="rgba(59,111,224,0.2)" stroke-width="1"/>
            <text x="720" y="76" text-anchor="middle" font-family="'Geist Mono Variable',monospace" font-size="9" fill="rgba(154,168,191,0.6)" letter-spacing="0.1em">CUSTOMERS</text>
            {['Enterprise HR','Operations','IT Admin','Finance'].map((name, i) => (
              <>
                <rect x="660" y={100 + i*24} width="120" height="18" rx="4" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
                <text x="720" y={113 + i*24} text-anchor="middle" font-family="'Geist Mono Variable',monospace" font-size="9" fill="rgba(232,237,245,0.65)">{name}</text>
              </>
            ))}
          </g>
        </svg>
      </div>

      <p class="arch-note reveal mt-6">
        Architecture reflects current product capabilities. Integration specifics marked TODO pending verification.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §6  SOLUTIONS / INDUSTRIES
       ════════════════════════════════════════════ -->
  <section class="section section--alt" aria-labelledby="solutions-heading">
    <div class="container">
      <div class="two-col-layout">
        <div class="two-col-layout__lead reveal">
          <span class="eyebrow">Solutions</span>
          <h2 id="solutions-heading" class="heading-h2">
            Built for the teams who run your business
          </h2>
          <p class="body-lg text-muted mt-4 measure">
            VYQDA products solve real operational problems for HR, operations, IT, and finance teams — across industries where precision and reliability are non-negotiable.
          </p>
          <a href="/solutions/" class="btn btn-secondary mt-8">
            View all solutions
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
        <div class="solutions-grid">
          {SOLUTIONS.map((s, i) => (
            <a href={`/solutions/#${s.slug}`} class="solution-card card reveal" data-delay={i * 70}>
              <div class="solution-card__icon">
                <Icon name={s.icon} size={20} />
              </div>
              <span class="eyebrow mt-4">{s.eyebrow}</span>
              <h3 class="heading-h4 mt-2">{s.title}</h3>
              <p class="text-muted mt-2" style="font-size:var(--text-sm);line-height:1.6">{s.body}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       §7  WHY VYQDA (stats + proof points)
       ════════════════════════════════════════════ -->
  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">The VYQDA Difference</span>
        <h2 id="why-heading" class="heading-h2">
          Precision over promises
        </h2>
      </div>

      <!-- Stats row — all placeholders -->
      <div class="stats-row mt-12">
        {STATS.map((s, i) => (
          <div class="stat-block reveal" data-delay={i * 60}>
            <div class="stat-block__number">
              {s.verified ? s.value + s.suffix : <span class="stat-todo">TODO</span>}
            </div>
            <div class="stat-block__label">{s.label}</div>
            {!s.verified && <span class="stat-verify-note">Pending verification</span>}
          </div>
