---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import Icon from '../../components/Icon.astro';
import { SEO } from '../../data/seo';

const seo = SEO.resources;
---

<Base seo={seo}>
  <section class="page-hero section--alt">
    <div class="container">
      <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Resources' }]} />
      <div class="reveal mt-8">
        <span class="eyebrow">Resources</span>
        <h1 class="heading-h1 mt-4">Guides, tools, and insights for HR and operations teams</h1>
        <p class="body-lg text-muted measure mt-6">
          Practical resources from VYQDA to help HR directors, operations managers, and IT teams make better decisions about workforce technology. All resources are coming soon — check back as we publish.
        </p>
      </div>
    </div>
  </section>

  <section id="guides" class="section" aria-labelledby="guides-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Guides</span>
        <h2 id="guides-heading" class="heading-h2">In-depth guides</h2>
      </div>
      <div class="grid-auto-3 mt-10">
        {[
          { icon: 'layers', title: 'Choosing the right attendance system for your workforce model', desc: 'A framework for evaluating attendance software across office, hybrid, and field workforce scenarios. Covers key decision criteria, common pitfalls, and implementation considerations.' },
          { icon: 'users', title: 'Managing hybrid workforces: a practical handbook for HR teams', desc: 'How leading HR teams structure policy, technology, and reporting for hybrid work. Includes checklists and a maturity model for assessing your current state.' },
          { icon: 'shield', title: 'Enterprise SaaS security checklist for HR software procurement', desc: 'What to ask vendors, what to require in contracts, and what to test before deployment. Covers data residency, access control, audit trails, and incident response.' },
        ].map((r, i) => (
          <div class="resource-card card reveal" data-delay={i * 80}>
            <div class="resource-card__tag">
              <span class="badge"><Icon name={r.icon} size={11} /> Guide</span>
              <span class="badge badge--neutral" style="opacity:0.5">Coming soon</span>
            </div>
            <h3 class="heading-h4 mt-4">{r.title}</h3>
            <p class="text-muted mt-3" style="font-size:var(--text-sm);line-height:1.65">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="tools" class="section section--alt" aria-labelledby="tools-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="eyebrow">Tools</span>
        <h2 id="tools-heading" class="heading-h2">Calculators and tools</h2>
      </div>
      <div class="grid-auto-3 mt-10">
        {[
          { icon: 'chart', title: 'Attendance ROI Calculator', desc: 'Quantify the cost of manual attendance processes — payroll errors, HR hours, and compliance exposure — and calculate the ROI of switching to an automated system.' },
          { icon: 'clock', title: 'Workforce Attendance Audit Template', desc: 'A structured template for auditing your current attendance process: data accuracy, reconciliation time, exception rates, and system gaps.' },
          { icon: 'building', title: 'Multi-Site Attendance Complexity Scorer', desc: 'Assess the complexity of managing attendance across multiple sites and work models, and identify where technology can remove the most friction.' },
        ].map((r, i) => (
          <div class="resource-card card reveal" data-delay={i * 80}>
            <div class="resource-card__tag">
              <span class="badge badge--blue"><Icon name={r.icon} size={11} /> Tool</span>
              <span class="badge badge--neutral" style="opacity:0.5">Coming soon</span>
            </div>
            <h3 class="heading-h4 mt-4">{r.title}</h3>
            <p class="text-muted mt-3" style="font-size:var(--text-sm);line-height:1.65">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand heading="Want to see a product before reading?" subhead="Schedule a 30-minute demo and see how VYQDA products handle your specific use case." />
</Base>

<style>
.page-hero { padding-block: clamp(3.5rem, 7vw, 7rem); }
.resource-card { display: flex; flex-direction: column; }
.resource-card__tag { display: flex; gap: var(--space-2); flex-wrap: wrap; }
</style>
