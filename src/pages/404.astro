---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SEO } from '../data/seo';
const seo = SEO.notFound;
---
<Base seo={seo}>
  <section class="section--dark not-found-section">
    <div class="nf-aurora" aria-hidden="true"></div>
    <div class="container not-found-inner">
      <div class="nf-code" aria-hidden="true">404</div>
      <h1 class="heading-h2 text-on-dark mt-6">Page not found</h1>
      <p class="body-lg text-on-dark-muted mt-5 measure-sm">
        The page you're looking for doesn't exist or has been moved. Try navigating from the homepage or explore our products.
      </p>
      <div class="btn-group mt-10">
        <a href="/" class="btn btn-primary btn-lg">Go to Homepage</a>
        <a href="/products/" class="btn btn-ghost btn-lg">
          Explore Products <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="nf-links mt-16">
        <p class="eyebrow eyebrow--dark">Popular pages</p>
        <ul role="list" class="nf-link-list mt-4">
          {[
            { href: '/products/timenox/', label: 'Timenox — Employee Attendance Software' },
            { href: '/products/', label: 'All Products' },
            { href: '/solutions/', label: 'Solutions by Team' },
            { href: '/contact/', label: 'Contact & Demo Request' },
          ].map(l => (
            <li><a href={l.href} class="nf-link">{l.label} →</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
<style>
.not-found-section { position: relative; overflow: hidden; min-height: 100vh; display: flex; align-items: center; }
.nf-aurora { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 60% 60% at 30% 50%, rgba(15,127,110,0.14) 0%, transparent 65%), radial-gradient(ellipse 50% 50% at 75% 40%, rgba(59,111,224,0.08) 0%, transparent 60%); }
.not-found-inner { position: relative; z-index: 1; padding-block: var(--section-py); }
.nf-code { font-family: var(--font-mono); font-size: clamp(5rem, 15vw, 12rem); font-weight: 700; letter-spacing: -0.05em; color: rgba(255,255,255,0.05); line-height: 1; user-select: none; }
.nf-links { display: flex; flex-direction: column; }
.nf-link-list { display: flex; flex-direction: column; gap: var(--space-2); }
.nf-link { font-size: var(--text-sm); color: var(--text-on-dark-muted); text-decoration: none; padding: var(--space-2) 0; border-bottom: 1px solid var(--line-dark); transition: color var(--duration-fast); display: block; }
.nf-link:hover { color: var(--teal-400); }
.nf-link:focus-visible { outline: 2px solid var(--teal-400); outline-offset: 2px; border-radius: 3px; }
</style>
